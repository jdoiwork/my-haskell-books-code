cabal-version: 3.0
name:          guilddb
version:       0.1.0.0
build-type:    Simple

-- 「データベース入門」の章のコード

common shared
  default-language: GHC2024
  ghc-options:      -Wall
  build-depends:
    , base          >=4.20 && <5
    , sqlite-simple ^>=0.4.19
    , text          ^>=2.1

-- The roster of the guild, kept in SQLite.
-- ギルドの名簿（SQLite に保存する）
library
  import:           shared
  exposed-modules:  Roster
                    Unsafe
                    RosterGeneric
                    RosterAnswers
  hs-source-dirs:   src
                    answers

-- The roster command: add, list, levelup, remove.
-- 名簿のコマンド：add、list、levelup、remove
executable roster
  import:           shared
  main-is:          Main.hs
  hs-source-dirs:   app
  build-depends:    guilddb
