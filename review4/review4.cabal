cabal-version: 3.0
name:          review4
version:       0.1.0.0
build-type:    Simple

-- 「第IV部のふりかえり」の総合トレーニングのコード

common shared
  default-language: GHC2024
  ghc-options:      -Wall
  build-depends:
    , base       >=4.20 && <5
    , bytestring ^>=0.12
    , containers ^>=0.8
    , parallel   ^>=3.3
    , deepseq    ^>=1.5

-- The pure core: read records, add them up, find the top.
-- 純粋な核：記録を読み、足し合わせ、上位を探す
library
  import:           shared
  exposed-modules:  Ledger
  hs-source-dirs:   src

-- The guild's ledger: read the records, print the report.
-- ギルドの決算：記録を読んで、報告を出す
executable ledger
  import:           shared
  main-is:          Main.hs
  hs-source-dirs:   app
  build-depends:    review4
  ghc-options:      -threaded -rtsopts

-- The slow, simple answer against the fast one.
-- 素朴で遅い解と、速い解を比べる
test-suite review4-test
  import:           shared
  type:             exitcode-stdio-1.0
  main-is:          Spec.hs
  hs-source-dirs:   test
  build-depends:
    , review4
    , hspec      ^>=2.11
    , QuickCheck ^>=2.19
