cabal-version: 3.0
name:          review-db-web
version:       0.1.0.0
build-type:    Simple

-- 「第III部のふりかえり」の総合トレーニングのコード

common shared
  default-language: GHC2024
  ghc-options:      -Wall
  build-depends:
    , base           >=4.20 && <5
    , aeson          ^>=2.3
    , sqlite-simple  ^>=0.4.19
    , text           ^>=2.1

-- The quest board: the gatekeeper, the store, and the API.
-- 依頼の掲示板：門番、置き場、API
library
  import:           shared
  exposed-modules:  Board.Title
                    Board.Store
                    Board.Api
  hs-source-dirs:   src
  build-depends:
    , servant-server ^>=0.20.3

-- The quest board server.
-- 依頼の掲示板のサーバー
executable questboard-api
  import:           shared
  main-is:          Main.hs
  hs-source-dirs:   app
  ghc-options:      -threaded
  build-depends:
    , review-db-web
    , warp           ^>=3.4

test-suite review-db-web-test
  import:           shared
  type:             exitcode-stdio-1.0
  main-is:          Spec.hs
  hs-source-dirs:   test
  build-depends:
    , review-db-web
    , hspec          ^>=2.11
    , hspec-wai      ^>=0.12
    , hspec-wai-json ^>=0.12
