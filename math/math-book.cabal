cabal-version: 3.0
name:          math-book
version:       0.1.0.0
build-type:    Simple

-- 第9部「プログラマーのための数学」のコード。章ごとにモジュールを分ける

common shared
  default-language: GHC2024
  ghc-options:      -Wall
  build-depends:
    , base             >=4.20 && <5
    , containers       ^>=0.8
    , random           >=1.2

library
  import:           shared
  exposed-modules:  Math.Numbers
                    Math.Logic
                    Math.Induction
                    Math.Growth
                    Math.Counting
                    Math.Stats
                    Math.Modular
                    Math.Graphs
                    Math.Vectors
                    Math.Calculus
                    Math.Algebra
                    NumbersAnswers
                    LogicAnswers
                    InductionAnswers
                    GrowthAnswers
                    CountingAnswers
                    StatsAnswers
                    ModularAnswers
                    GraphsAnswers
                    VectorsAnswers
                    CalculusAnswers
                    AlgebraAnswers
  hs-source-dirs:   src answers

test-suite math-test
  import:           shared
  type:             exitcode-stdio-1.0
  main-is:          Spec.hs
  other-modules:    NumbersSpec
                    LogicSpec
                    InductionSpec
                    GrowthSpec
                    CountingSpec
                    StatsSpec
                    ModularSpec
                    GraphsSpec
                    VectorsSpec
                    CalculusSpec
                    AlgebraSpec
  hs-source-dirs:   test
  build-depends:
    , math-book
    , hspec            ^>=2.11
    , QuickCheck       ^>=2.19

-- The benchmark of the fast inverse square root (the chapter "Numbers").
-- 高速逆平方根のベンチマーク（「数の正体」の章）
benchmark math-bench
  import:           shared
  type:             exitcode-stdio-1.0
  main-is:          Bench.hs
  hs-source-dirs:   bench
  ghc-options:      -O2
  build-depends:
    , math-book
    , tasty-bench ^>=0.5
