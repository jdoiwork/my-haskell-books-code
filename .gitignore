# Build output / ビルドの出力
dist-newstyle/
dist-prof/
dist-984/
dist-werror/
# The times of scripts/check-code.sh / check-code.sh の項目ごとの時間
.check-times/
node_modules/
# What vite build writes for the shelf's React screen
# 本棚の React の画面で、vite build が書くもの
tsundoku/*/web/dist/
# A shelf to try the screens by hand (shelf serve)
# 画面を手で試すための本棚（shelf serve）
tsundoku/*/try/
target/

# hspec-golden writes the latest output next to the golden file
# hspec-golden が、最新の出力をゴールデンファイルの隣に書く
**/.golden/*/actual

# Files written when you try the programs
# プログラムを試したときに書かれるファイル
minisearch/*/index*.json
minisearch/*/index*.bin
minikv/*/minikv.log*

# MNIST, downloaded for the neural network chapter (about 55 MB)
# ニューラルネットワークの章でダウンロードする MNIST（約 55 MB）
ml/data/
# Liquid Haskell の作業ファイル
.liquid/

# The shelf's secrets and settings when tried with docker compose
# docker compose で試したときの、本棚の秘密と設定
tsundoku/*/db_password.txt
# SQLite files made by trying the examples (tsundoku.db, try.db)
# 例を試して作った SQLite のファイル（tsundoku.db、try.db）
*.db
tsundoku/*/.env
