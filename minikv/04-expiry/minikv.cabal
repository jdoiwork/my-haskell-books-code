cabal-version: 3.0
name:          minikv
version:       0.4.0.0
build-type:    Simple

-- 第10部 総合演習4：型に厳しいインメモリデータベースを作る
-- （4. 期限切れと時計）

-- ANCHOR: shared
common shared
  default-language: GHC2024
  default-extensions: OverloadedStrings
  ghc-options:      -Wall
  build-depends:
    , base             >=4.20 && <5
    , containers       ^>=0.8
    , text             ^>=2.1
    , bytestring       ^>=0.12
    , network          ^>=3.2
    , stm              ^>=2.5
    , time             >=1.12
    , async            ^>=2.2
-- ANCHOR_END: shared

library
  import:           shared
  exposed-modules:  MiniKv.Types
                    MiniKv.Store
                    MiniKv.Examples
                    MiniKv.Wire
                    MiniKv.Protocol
                    MiniKv.Server
                    MiniKv.Client
                    KvAnswers
                    ExpiryAnswers
  hs-source-dirs:   src answers

-- ANCHOR: exe
executable minikv-server
  import:           shared
  main-is:          Main.hs
  hs-source-dirs:   app
  ghc-options:      -threaded "-with-rtsopts=-N"
  build-depends:
    , minikv
-- ANCHOR_END: exe

test-suite minikv-test
  import:           shared
  type:             exitcode-stdio-1.0
  main-is:          Spec.hs
  hs-source-dirs:   test
  ghc-options:      -threaded "-with-rtsopts=-N"
  build-depends:
    , minikv
    , async            ^>=2.2
    , bytestring
    , hspec            ^>=2.11
    , QuickCheck       ^>=2.19
