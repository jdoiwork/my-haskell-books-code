cabal-version: 3.0
name:          minikv
version:       0.2.0.0
build-type:    Simple

-- 第10部 総合演習4：型に厳しいインメモリデータベースを作る
-- （2. プロトコルとパーサー）

-- ANCHOR: lib
common shared
  default-language: GHC2024
  default-extensions: OverloadedStrings
  ghc-options:      -Wall
  build-depends:
    , base             >=4.20 && <5
    , containers       ^>=0.8
    , text             ^>=2.1
    , bytestring       ^>=0.12

library
  import:           shared
  exposed-modules:  MiniKv.Types
                    MiniKv.Store
                    MiniKv.Examples
                    MiniKv.Wire
                    MiniKv.Protocol
                    KvAnswers
  hs-source-dirs:   src answers
-- ANCHOR_END: lib

test-suite minikv-test
  import:           shared
  type:             exitcode-stdio-1.0
  main-is:          Spec.hs
  hs-source-dirs:   test
  build-depends:
    , minikv
    , hspec            ^>=2.11
    , QuickCheck       ^>=2.19
