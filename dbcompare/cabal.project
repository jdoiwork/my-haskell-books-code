-- The beam and persistent examples of the "typed SQL" chapter.
-- persistent is not ready for GHC 9.14 yet (2026-11), so this is a separate
-- project with allow-newer, not part of code/cabal.project.
-- 「型で SQL を守る」の章の beam と persistent の例
-- persistent はまだ GHC 9.14 に対応していない（2026-11）ので、allow-newer を
-- 付けた別のプロジェクトにしている（code/cabal.project には入れない）
packages: .

allow-newer:
  , persistent:template-haskell
  , persistent:aeson
  , persistent-sqlite:aeson
