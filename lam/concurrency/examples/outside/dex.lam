#!/usr/bin/env lam
-- ANCHOR: all
-- 📕 A small Pokédex. Look each Pokémon up in dex.db first, and ask
--    PokeAPI only for the ones that are not there yet: a Pokémon's
--    height and weight do not change, so what is kept stays right.
--      lam dex.lam pikachu bulbasaur
-- 小さなポケモン図鑑。まず dex.db で探し、まだないものだけを PokeAPI に
-- 聞く。ポケモンの高さと重さは変わらないので、貯めたものは古くならない

-- ANCHOR: settings
let api = "https://pokeapi.co/api/v2/"
let dbFile = "dex.db"

let schema =
  "CREATE TABLE IF NOT EXISTS dex (name TEXT PRIMARY KEY,"
    ++ " id INTEGER, ja TEXT, height INTEGER, weight INTEGER, types TEXT)"
-- ANCHOR_END: settings

-- ANCHOR: read
-- 🔤 The Japanese name, from the names of the species.
-- 種族の名前の一覧から、日本語の名前を
let japaneseName species = Maybe.do
  names <- Maybe.andThen Json.array (Json.get "names" species)
  ja <- find (\n -> Json.at ["language", "name"] n == Just (JStr "ja")) names
  Maybe.andThen Json.string (Json.get "name" ja)

-- 🏷️ The types, joined: "grass/poison"
-- タイプをつなぐ
let typesOf pokemon =
  case Maybe.andThen Json.array (Json.get "types" pokemon) of
    | Nothing -> ""
    | Just ts ->
        let name t = Maybe.andThen Json.string (Json.at ["type", "name"] t)
        in join "/" (map (\t -> fromMaybe "?" (name t)) ts)

-- 🌐 Ask PokeAPI twice (the Pokémon, and its species), and make the
--    cells of one row.
-- PokeAPI に2回聞き（ポケモンと、その種族）、1行分のマスを作る
let fetch name = do
  pokemon <- Http.get f"{api}pokemon/{name}"
  species <- Http.get f"{api}pokemon-species/{name}"
  let field k j = fromMaybe JNull (Json.get k j)
  pure (Result.do
    p <- pokemon
    s <- species
    Ok [ JStr name, field "id" p, JStr (fromMaybe name (japaneseName s))
       , field "height" p, field "weight" p, JStr (typesOf p) ])
-- ANCHOR_END: read

-- ANCHOR: lookUp
-- 🔎 The row of a Pokémon, and where it came from: the cache (dex.db)
--    or the web. Only the web costs a request.
-- ポケモンの行と、出どころ：キャッシュ（dex.db）か Web か。
-- 頼みごとがかかるのは Web だけ
let find1 db name =
  Sql.query db "SELECT * FROM dex WHERE name = ?" [JStr name]

let lookUp db name = do
  found <- find1 db name
  case found of
    | Err e -> pure (Err e)
    | Ok (row : _) -> pure (Ok (row, "cache"))
    | Ok [] -> do
        fetched <- fetch name
        case fetched of
          | Err e -> pure (Err e)
          | Ok cells -> do
              _ <- Sql.exec db
                     "INSERT INTO dex VALUES (?, ?, ?, ?, ?, ?)" cells
              again <- find1 db name
              pure (case again of
                | Ok (row : _) -> Ok (row, "web")
                | Ok [] -> Err "not saved (is it --dry-run?)"
                | Err e -> Err e)
-- ANCHOR_END: lookUp

-- ANCHOR: show
-- 📏 4 -> "0.4". PokeAPI gives tenths: decimetres and hectograms.
-- PokeAPI の数は 10 分の 1 の単位（デシメートルとヘクトグラム）
let tenths j =
  case Json.int j of
    | Just n -> f"{n // 10}.{mod n 10}"
    | Nothing -> "?"

-- 🖨️ "#25  ピカチュウ  0.4 m  6.0 kg  electric  (web)"
let line row from =
  let get k = fromMaybe JNull (Sql.column k row) in
  let text k = fromMaybe "?" (Json.string (get k)) in
  f"#{Json.show (get "id")}  {text "ja"}  {tenths (get "height")} m  "
    ++ f"{tenths (get "weight")} kg  {text "types"}  ({from})"
-- ANCHOR_END: show

-- ANCHOR: main
let main args = do
  opened <- Sql.open dbFile
  case opened of
    | Err e -> do
        ePutStrLn f"dex: {e}"
        exit 1
    | Ok db -> do
        _ <- Sql.exec db schema []
        forEach args (\name -> do
          answer <- lookUp db (toLower name)
          case answer of
            | Ok (row, from) -> putStrLn (line row from)
            | Err e -> ePutStrLn f"dex: {name}: {e}")
-- ANCHOR_END: main
-- ANCHOR_END: all
