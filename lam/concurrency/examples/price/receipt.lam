-- ANCHOR: all
-- 🧾 A receipt, with prices made by Price.fromYen.
-- Price.fromYen で作った値段で、レシートを
import Price

let prices = [Price.fromYen 1200, Price.fromYen 350, Price.fromYen -5]

let main =
  forEach prices (\m ->
    case m of
      | Just p -> putStrLn (Price.show p)
      | Nothing -> putStrLn "not a price")
-- ANCHOR_END: all
