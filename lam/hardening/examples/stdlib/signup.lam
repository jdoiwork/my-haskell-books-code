-- 🧹 Clean up the sign-up sheet of the quiz: trim the spaces, cut at
--    ",", and skip the comments and the empty lines.
-- クイズ大会の申しこみ表を、きれいにする：空白を落とし、「,」で切る。
-- コメントと空の行は飛ばす
--   lam examples/stdlib/signup.lam

-- ANCHOR: sheet
-- 📝 The sheet as people wrote it by hand, a line each.
-- 人が手で書いたままの表。1行ずつ
sheet =
  [ "# name, mail, language"
  , "  Python , python@lam.test , Python"
  , "TS,ts@lam.test,TypeScript"
  , "# Rust came late"
  , " Rust ,   rust@lam.test,Rust"
  , "Ruby, ruby-at-lam.test, Ruby"
  , ""
  , "Erlang , erlang@lam.test" ]
-- ANCHOR_END: sheet

-- ANCHOR: cells
-- ✂️ One row of the sheet:  " TS , ts@lam.test,TypeScript"  gives
--    ["TS", "ts@lam.test", "TypeScript"].
-- 表の1行を、切って、それぞれのまわりの空白を落とす
cells line = line |> String.split "," |> map String.trim

-- 🙈 A comment (# ...) or an empty line is not a row.
-- コメント（# ...）と空の行は、行ではない
isRow line =
  let text = String.trim line in
  not (String.isEmpty text || String.startsWith "#" text)
-- ANCHOR_END: cells

-- ANCHOR: mail
-- 📮 "ruby-at-lam.test" is written to hide the @: put it back.
-- 「@」を隠して書いた「-at-」を、@ に戻す
fixMail mail = String.replace "-at-" "@" mail
-- ANCHOR_END: mail

-- ANCHOR: main
-- 🎫 A row with 3 cells is an entry; the others are broken.
-- 3つに切れた行が申しこみ。ほかは壊れた行
rows = sheet |> filter isRow |> map cells

entries =
  rows
    |> filter (\row -> length row == 3)
    |> map (\[name, mail, language] ->
              { name = name, mail = fixMail mail, language = language })

broken = rows |> filter (\row -> length row /= 3) |> map (join " | ")

(map .name entries, broken)
-- ANCHOR_END: main
