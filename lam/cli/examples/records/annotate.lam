-- ✍️ Type annotations on the lines above the definitions. A definition
--    at the top of a file needs no let any more.
-- 定義の上の行に、型の注釈。ファイルのいちばん外の定義には、もう let
-- は要らない
--   lam examples/records/annotate.lam

-- ANCHOR: add
-- ➕ Two Ints in, one Int out.
-- Int を2つ受け取り、Int を1つ返す
add : Int -> Int -> Int
add x y = x + y
-- ANCHOR_END: add

-- ANCHOR: classes
-- 🏆 Any type that can be compared: the class goes in front, as in
--    the REPL.
-- 比べられる型なら何でも。クラスは、REPL の表示と同じく前に書く
largest : Comparable a => [a] -> Maybe a
largest xs =
  case xs of
    | [] -> Nothing
    | x : rest -> Just (foldl max x rest)

-- 🔁 Any type that can be joined with ++: strings, and lists.
-- ++ でつなげる型なら何でも：文字列とリスト
echo : Semigroup a => a -> a
echo x = x ++ x
-- ANCHOR_END: classes

-- ANCHOR: swap
-- 🔄 a and b may be any types, and may differ.
-- a と b は、どんな型でもよく、ちがっていてもよい
swap : (a, b) -> (b, a)
swap (x, y) = (y, x)
-- ANCHOR_END: swap

-- ANCHOR: final
( add 1 2
, largest ["Rust", "Lam", "Python"]
, echo "la"
, echo [1, 2]
, swap ("Lam", 9) )
-- ANCHOR_END: final
