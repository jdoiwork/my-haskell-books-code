-- ANCHOR: all
type alias Options =
  { -- Who to greet
    name : String
    -- How many times
  , count : Int = 1
    -- Shout it
  , loud : Bool
  , alias n = count
  }

-- Greet someone, as many times as you like.
main : Options -> IO ()
main opts = do
  let line = f"Hello, {opts.name}!"
  forEach (range 1 opts.count) (\_ ->
    putStrLn (if opts.loud then toUpper line else line))
-- ANCHOR_END: all
