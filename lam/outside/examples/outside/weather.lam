#!/usr/bin/env lam
-- ANCHOR: all
-- 🌦️ The forecast for the week from Open-Meteo, kept in SQLite. Run it
--    every day: the table grows, and a day that is forecast again shows
--    what changed.
--      lam weather.lam                (Tokyo)
--      lam weather.lam 34.69 135.50   (latitude and longitude: Osaka)
-- Open-Meteo の1週間の予報を SQLite に貯める。毎日動かすと表が育ち、
-- 予報が変わった日は、何が変わったかを見せる
--   Weather data by Open-Meteo.com (https://open-meteo.com/), CC BY 4.0

-- ANCHOR: settings
-- 🔗 The URL of the forecast: the place, and the three numbers we want.
-- 予報の URL：場所と、ほしい3つの数
let urlFor lat lon =
  "https://api.open-meteo.com/v1/forecast"
    ++ f"?latitude={lat}&longitude={lon}"
    ++ "&daily=temperature_2m_max,temperature_2m_min,"
    ++ "precipitation_probability_max&timezone=auto"
let dbFile = "weather.db"
-- ANCHOR_END: settings

-- ANCHOR: read
-- 📋 A JSON array of strings, as a list of strings.
-- 文字列の JSON の配列を、文字列のリストに
let texts j =
  Maybe.map (map (\x -> fromMaybe "" (Json.string x))) (Json.array j)

-- 🤐 Four lists, as one list of fours.
-- 4つのリストを、4つ組のリストに
let zip4 ws xs ys zs =
  case (ws, xs, ys, zs) of
    | (w : ws2, x : xs2, y : ys2, z : zs2) ->
        (w, x, y, z) : zip4 ws2 xs2 ys2 zs2
    | _ -> []

-- 📦 The days of the forecast: (day, rain %, max, min). The numbers
--    stay Json (JInt, JDec, or JNull), to go into SQLite as they are.
--    Nothing if the JSON has another shape.
-- 予報の日々：（日、降水確率、最高、最低）。数は Json のまま
-- （JInt・JDec・JNull）で、そのまま SQLite に入れる。形がちがえば Nothing
let weekOf doc = Maybe.do
  daily <- Json.get "daily" doc
  days <- Maybe.andThen texts (Json.get "time" daily)
  pops <- Maybe.andThen Json.array
            (Json.get "precipitation_probability_max" daily)
  maxs <- Maybe.andThen Json.array (Json.get "temperature_2m_max" daily)
  mins <- Maybe.andThen Json.array (Json.get "temperature_2m_min" daily)
  Just (zip4 days pops maxs mins)
-- ANCHOR_END: read

-- ANCHOR: save
-- 🌡️ A number for the table: "-" when there is none. A temperature
--    has one digit after the point (Json.fixed): 3.0, not 3.
-- 表に出す数：ないときは "-"。気温は小数点以下1けた（Json.fixed）：
-- 3 ではなく 3.0
let cell j = case j of | JNull -> "-" | _ -> Json.show j
let temp j = case j of | JNull -> "-" | _ -> Json.fixed 1 j
let percent j = case j of | JNull -> "-" | _ -> Json.show j ++ "%"
let columnText name row = cell (fromMaybe JNull (Sql.column name row))

-- 📝 What changed since the last run: "new", "max 13.1 -> 14.6", or "".
--    No number now (JNull) is not a change: the old one is kept.
-- 前に動かしたときから変わったこと。いま数がない（JNull）のは変化では
-- ない：前の数を残す
let diff label shown column row now =
  case Sql.column column row of
    | Just before ->
        if before == now || now == JNull then []
        else [f"{label} {shown before} -> {shown now}"]
    | Nothing -> []
let changes old pop tmax tmin =
  case old of
    | Ok (row : _) ->
        join ", " (diff "rain" percent "pop" row pop
                     ++ diff "max" temp "tmax" row tmax
                     ++ diff "min" temp "tmin" row tmin)
    | _ -> "new"

-- 💾 Save one day of a place (insert it, or update it), and give a
--    line to show.
-- 1か所の1日分を貯め（足すか、書き換える）、見せる1行を返す
let save db place day =
  case day of
    | (d, pop, tmax, tmin) -> do
        old <- Sql.query db
          "SELECT * FROM weather WHERE place = ? AND day = ?"
          [JStr place, JStr d]
        saved <- Sql.exec db
          ("INSERT INTO weather (place, day, pop, tmax, tmin)"
            ++ " VALUES (?, ?, ?, ?, ?)"
            ++ " ON CONFLICT (place, day) DO UPDATE SET"
            ++ " pop = coalesce(excluded.pop, pop),"
            ++ " tmax = coalesce(excluded.tmax, tmax),"
            ++ " tmin = coalesce(excluded.tmin, tmin)")
          [JStr place, JStr d, pop, tmax, tmin]
        -- Show what the table holds: the old number when none came.
        -- 表が持つ数を見せる：来なかったら前の数
        let held name now =
              case (now, old) of
                | (JNull, Ok (row : _)) ->
                    fromMaybe JNull (Sql.column name row)
                | _ -> now
        let line =
              f"{d}  rain {percent (held "pop" pop):>4}  "
                ++ f"max {temp (held "tmax" tmax):>5}  "
                ++ f"min {temp (held "tmin" tmin):>5}"
        let changed = changes old pop tmax tmin
        pure (case saved of
          | Err e -> f"{line}  error: {e}"
          | Ok _ -> if changed == "" then line else f"{line}  {changed}")
-- ANCHOR_END: save

-- ANCHOR: main
-- 🛑 Tell why, and stop with the exit code 1.
-- わけを言って、終了コード 1 で止まる
let stop message = do
  ePutStrLn f"weather: {message}"
  exit 1

let schema =
  "CREATE TABLE IF NOT EXISTS weather (place TEXT, day TEXT,"
    ++ " pop INTEGER, tmax REAL, tmin REAL, PRIMARY KEY (place, day))"

-- 📍 The place: Tokyo, or the latitude and the longitude given.
-- 場所：東京か、渡された緯度と経度
let placeOf args =
  case args of
    | [] -> Just ("35.68", "139.76")
    | [lat, lon] -> Just (lat, lon)
    | _ -> Nothing

let main args =
  case placeOf args of
    | Nothing -> stop "give a latitude and a longitude, or nothing for Tokyo"
    | Just (lat, lon) -> do
        let place = f"{lat},{lon}"
        answer <- Http.get (urlFor lat lon)
        opened <- Sql.open dbFile
        case (answer, opened) of
          | (Err e, _) -> stop e
          | (_, Err e) -> stop e
          | (Ok doc, Ok db) ->
              case weekOf doc of
                | Nothing -> stop "the forecast has another shape"
                | Just days -> do
                    _ <- Sql.exec db schema []
                    forEach days (\day -> bind (save db place day) putStrLn)
                    -- The table keeps the days that are past, too.
                    -- 表には、過ぎた日も残っている
                    kept <- Sql.query db
                      ("SELECT count(*) AS n, max(tmax) AS hottest"
                         ++ " FROM weather WHERE place = ?") [JStr place]
                    case kept of
                      | Ok [row] ->
                          putStrLn (f"kept {columnText "n" row} days, "
                            ++ f"the hottest {temp (fromMaybe JNull
                                (Sql.column "hottest" row))}")
                      | _ -> pure ()
-- ANCHOR_END: main
-- ANCHOR_END: all
