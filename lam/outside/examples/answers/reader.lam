-- ANCHOR: all
-- 📖 Step 1: a reader of our own. Read only one field of the JSON,
--    so that the answer is that field, not the whole document.
-- ステップ1：自分の読み方。JSON の1つの項目だけを読むので、答えは
-- 文書全体ではなく、その項目になる

-- ANCHOR: field
-- 🔎 A reader: the field name of the JSON body, or why not.
-- 読み方：JSON の本文の、項目 name。なければ、そのわけ
let field name r =
  case Http.json r of
    | Err e -> Err e
    | Ok j ->
        case Json.get name j of
          | Just v -> Ok v
          | Nothing -> Err f"no field {name}"
-- ANCHOR_END: field

let weightOf name =
  Http.request (field "weight") Http.string "GET"
    f"https://pokeapi.co/api/v2/pokemon/{name}" {} ""

let main = do
  a <- weightOf "pikachu"
  putStrLn (show a)
  b <- weightOf "nosuchmon"
  putStrLn (show b)
  c <- Http.request (field "color") Http.string "GET"
         "https://pokeapi.co/api/v2/pokemon/pikachu" {} ""
  putStrLn (show c)
-- ANCHOR_END: all
