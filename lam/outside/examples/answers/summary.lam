-- ANCHOR: all
-- 📊 Step 2: what weather.lam kept, summed up by SQL. Run it after
--    weather.lam: it only reads weather.db.
-- ステップ2：weather.lam が貯めたものを、SQL でまとめる。weather.lam の
-- あとに動かす。weather.db を読むだけ

-- 🌡️ A cell for people: "-" for JNull.
-- 人が読むマス：JNull なら "-"
let text j = case j of | JNull -> "-" | _ -> Json.show j
let get k row = text (fromMaybe JNull (Sql.column k row))

-- ANCHOR: summary
let summary =
  "SELECT count(*) AS days,"
    ++ " sum(CASE WHEN pop >= 30 THEN 1 ELSE 0 END) AS rainy,"
    ++ " round(avg(tmax), 1) AS hot, round(avg(tmin), 1) AS cold"
    ++ " FROM weather"
-- ANCHOR_END: summary

let main = do
  opened <- Sql.openReadOnly "weather.db"
  case opened of
    | Err e -> do
        ePutStrLn f"summary: {e} (run weather.lam first)"
        exit 1
    | Ok db -> do
        rows <- Sql.query db summary []
        case rows of
          | Ok [row] -> do
              putStrLn f"{get "days" row} days, {get "rainy" row} rainy"
              putStrLn f"max {get "hot" row} on average, min {get "cold" row}"
          | Ok _ -> putStrLn "no rows"
          | Err e -> ePutStrLn f"summary: {e}"
-- ANCHOR_END: all
