-- ANCHOR: all
-- 🎒 Step 3: a transaction in Lam, with Sql.exec only. Give Poké Balls
--    from one bag to another: both changes, or neither.
-- ステップ3：Sql.exec だけで、Lam でトランザクション。モンスターボールを
-- 袋から袋へ渡す：2つの変更の両方か、どちらもなしか

-- ANCHOR: transaction
-- 🔁 BEGIN, the steps, then COMMIT if they gave Ok, or ROLLBACK.
-- BEGIN、手順、それから Ok なら COMMIT、Err なら ROLLBACK
let transaction db steps = do
  _ <- Sql.exec db "BEGIN" []
  result <- steps
  case result of
    | Ok x -> do
        done <- Sql.exec db "COMMIT" []
        pure (Result.map (\_ -> x) done)
    | Err e -> do
        _ <- Sql.exec db "ROLLBACK" []
        pure (Err e)
-- ANCHOR_END: transaction

-- 🎁 Add n to one bag, then take n from the other. The second change
--    fails when the bag would go below 0 (the CHECK of the table).
-- 片方の袋に n 足し、もう片方から n 引く。袋が 0 を下回ると、2つ目の
-- 変更が失敗する（表の CHECK）
let give db from to n = do
  added <- Sql.exec db "UPDATE bag SET balls = balls + ? WHERE owner = ?"
             [JInt n, JStr to]
  taken <- Sql.exec db "UPDATE bag SET balls = balls - ? WHERE owner = ?"
             [JInt n, JStr from]
  pure (Result.bind added (\_ -> taken))

-- 👀 What is in the bags now: "lam 2, rust 4"
-- いま袋に入っている数
let bags db = do
  rows <- Sql.query db "SELECT owner, balls FROM bag ORDER BY owner" []
  let text j = case j of | JStr s -> s | _ -> Json.show j
  let shown row =
        join " " (map (\k -> text (fromMaybe JNull (Sql.column k row)))
                      ["owner", "balls"])
  pure (case rows of
    | Ok rs -> join ", " (map shown rs)
    | Err e -> e)

let main = do
  opened <- Sql.open ":memory:"
  case opened of
    | Err e -> ePutStrLn e
    | Ok db -> do
        _ <- Sql.exec db
               ("CREATE TABLE bag (owner TEXT PRIMARY KEY,"
                  ++ " balls INTEGER CHECK (balls >= 0))") []
        _ <- Sql.exec db "INSERT INTO bag VALUES ('lam', 5), ('rust', 1)" []
        a <- transaction db (give db "lam" "rust" 3)
        putStrLn f"give 3:  {show a}"
        bags db |> IO.andThen putStrLn
        b <- transaction db (give db "lam" "rust" 9)
        putStrLn f"give 9:  {show b}"
        bags db |> IO.andThen putStrLn
        -- Without a transaction, the first change stays: 9 balls more.
        -- トランザクションなしだと、1つ目の変更が残る：ボールが9個増える
        c <- give db "lam" "rust" 9
        putStrLn f"careless: {show c}"
        bags db |> IO.andThen putStrLn
-- ANCHOR_END: all
