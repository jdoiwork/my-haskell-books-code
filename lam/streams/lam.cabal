cabal-version: 3.0
name:          lam
version:       0.17.0.0
build-type:    Simple

-- 第15部 Lam でスクリプトを書く（5. 大きいファイルとバイト列：1行ずつ読む・ハッシュ・base64）

common shared
  default-language: GHC2024
  ghc-options:      -Wall
  build-depends:
    , base             >=4.20 && <5
    , containers       ^>=0.8
    , text             ^>=2.1

-- ANCHOR: lib
library
  import:           shared
  exposed-modules:  Lam.Syntax
                    Lam.Pretty
                    Lam.Examples
                    Lam.Parser
                    Lam.Eval
                    Lam.Types
                    Lam.Program
                    Lam.Data
                    Lam.Builtins
                    Lam.Prelude
                    Lam.Repl
                    Lam.Sugar
                    Lam.Float
                    Lam.Class
                    Lam.Json
                    Lam.Stdlib
                    Lam.Format
                    Lam.Module
                    Lam.Io
                    Lam.World
                    Lam.Clock
                    Lam.Files
                    Lam.Utf8
                    Lam.Bytes
                    -- The answers of the training
                    -- トレーニングの解答
                    Lam.Answers
  hs-source-dirs:   src answers
  -- ANCHOR: deps
  build-depends:
    , megaparsec         ^>=9.8
    , parser-combinators ^>=1.3
    , mtl                ^>=2.3
    , aeson              ^>=2.3
    , attoparsec         ^>=0.14
    , attoparsec-aeson   ^>=2.2
    , scientific         ^>=0.3
    , vector             ^>=0.13
    -- Json.pretty
    , aeson-pretty       ^>=0.8
    -- import: the files of modules, and LAM_PATH
    -- import：モジュールのファイルと、LAM_PATH
    , filepath           ^>=1.5
    , directory          ^>=1.3
    , transformers       ^>=0.6
    -- ANCHOR: filesDeps
    -- The clock, commands, globs (logs/*.log), and dice.
    -- 時計、コマンド、glob（logs/*.log）、さいころ
    , time               ^>=1.15
    , process            ^>=1.6
    , Glob               ^>=0.10
    , random             ^>=1.3
    -- ANCHOR_END: filesDeps
    -- ANCHOR: bytesDeps
    -- Bytes, SHA-256, and base64.
    -- バイト列、SHA-256、base64
    , bytestring         ^>=0.12
    , cryptohash-sha256  ^>=0.11.102
    , base64-bytestring  ^>=1.2
    , base16-bytestring  ^>=1.0
    -- ANCHOR_END: bytesDeps
    -- The training (Bytes.gunzip)
    -- トレーニング（Bytes.gunzip）
    , zlib               ^>=0.7.1
  -- ANCHOR_END: deps
-- ANCHOR_END: lib

-- ANCHOR: exe
executable lam
  import:           shared
  main-is:          Main.hs
  hs-source-dirs:   app
  -- +RTS -s: how much memory a script took (see the morning's log).
  -- +RTS -s：スクリプトがどれだけメモリを使ったか（朝のログで見る）
  ghc-options:      -rtsopts
  build-depends:
    , lam
    , haskeline        ^>=0.8
    , filepath         ^>=1.5
-- ANCHOR_END: exe

test-suite lam-test
  import:           shared
  type:             exitcode-stdio-1.0
  main-is:          Spec.hs
  hs-source-dirs:   test
  build-depends:
    , lam
    , hspec            ^>=2.11
    , megaparsec       ^>=9.8
    , QuickCheck       ^>=2.19
    , aeson            ^>=2.3
    , scientific       ^>=0.3
    , vector           ^>=0.13
    , filepath         ^>=1.5
    , directory        ^>=1.3
    , mtl              ^>=2.3
    , time             ^>=1.15
    , random           ^>=1.3
    , bytestring       ^>=0.12
    , cryptohash-sha256 ^>=0.11.102
    , zlib             ^>=0.7.1
