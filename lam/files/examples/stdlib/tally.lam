-- 🗳️ The votes for "the language I want to try next", for two days.
--    A vote is a line; "-Rust" takes one back.
-- 「次に試したい言語」の投票を、2日ぶん。1行が1票。「-Rust」は1票
-- 取り消す
--   lam examples/stdlib/tally.lam

-- ANCHOR: days
day1 = ["Lam", "Rust", "Lam", "Python", "-Rust", "Haskell"]
day2 = ["Lam", "Haskell", "Rust", "Haskell", "Go"]
-- ANCHOR_END: days

-- ANCHOR: vote
-- 🗳️ Add one vote, or take one back. Map.update gives f the count
--    (Nothing when there is none yet); f giving Nothing deletes it.
-- 1票足すか、取り消す。Map.update は f に今の数（まだなければ
-- Nothing）を渡す。f が Nothing を返せば消す
vote counts line =
  if String.startsWith "-" line then
    Map.update (drop 1 line)
      (\n ->
        case n of
          | Just k -> if k > 1 then Just (k - 1) else Nothing
          | Nothing -> Nothing)
      counts
  else
    Map.update line (\n -> Just ((n ?: 0) + 1)) counts

tally day = foldl vote {} day
-- ANCHOR_END: vote

-- ANCHOR: show
-- 🖨️ "Haskell 3, Lam 3": Map.foldWithKey goes through the keys in
--    order, with each value.
-- キーの順に、値と一緒にたどる
showCounts counts =
  Map.foldWithKey (\k n acc -> (k ++ " " ++ showInt n) : acc) [] counts
    |> join ", "
-- ANCHOR_END: show

-- ANCHOR: main
days = [tally day1, tally day2]

-- Add the days up: a language on both days gets the sum.
-- 日ごとの数を足し合わせる。両方の日にある言語は、数を足す
total = foldl (Map.unionWith (+)) {} days

-- Both days, and only those with 2 votes or more.
-- 2日ぶんと、2票以上のものだけ
(showCounts total, showCounts (Map.filter (\n -> n >= 2) total))
-- ANCHOR_END: main
