-- ANCHOR: all
-- 🎴 Step 1: a fortune, picked at random. The same seed gives the
--    same fortune:  lam --seed=618 omikuji.lam
-- ステップ1：おみくじを、でたらめに1つ。同じ種なら同じおみくじ

fortunes : [String]
fortunes = ["great luck", "good luck", "small luck", "bad luck"]

main : IO ()
main = do
  picked <- Random.pick fortunes
  -- The lucky number: from 1 to 9.
  -- ラッキーナンバー：1 から 9
  number <- Random.int 1 9
  case picked of
    | Just f -> putStrLn f"{f}! (lucky number: {number})"
    | Nothing -> putStrLn "no fortunes today"
-- ANCHOR_END: all
