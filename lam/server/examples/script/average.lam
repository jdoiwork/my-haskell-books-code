-- 🧮 The average of a list. It has a mistake on purpose: the empty
--    list divides by zero. The error says where.
-- リストの平均。わざとまちがいがある：空のリストで 0 で割る。
-- エラーが場所を教えてくれる

average : [Int] -> Int
average xs = sum xs // length xs

main : IO ()
main = do
  putStrLn f"{average [3, 4, 5]}"
  putStrLn f"{average []}"
