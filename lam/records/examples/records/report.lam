-- 📊 The body first, the parts after it with where.
-- 本体を先に、部品は where で後ろに
--   lam examples/records/report.lam

-- ANCHOR: summary
summary : [Int] -> String
summary scores =
  f"{count} scores, total {total}, average {average}, best {best}"
  where
    count = length scores
    total = sum scores
    average = total / count
    best = fromMaybe 0 (maximum scores)
-- ANCHOR_END: summary

main : IO ()
main = putStrLn (summary [82, 75, 91, 64])
