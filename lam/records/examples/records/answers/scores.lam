-- 🏅 Step 3: a table of scores, with records.
-- ステップ3：レコードで成績表
--   lam examples/records/answers/scores.lam

-- ANCHOR: scores
type alias Player = { name : String, score : Int }

players : [Player]
players =
  [ { name = "Python", score = 82 }
  , { name = "TS", score = 75 }
  , { name = "Rust", score = 91 } ]

-- Everyone gets some points more.
-- 全員に、何点か足す
bonus : Int -> [Player] -> [Player]
bonus n ps = map (\p -> { p | score = p.score + n }) ps

-- The best one (Nothing for nobody).
-- いちばんの人（だれもいなければ Nothing）
top : [Player] -> Maybe Player
top ps = case reverse (sortOn .score ps) of
  | p : _ -> Just p
  | [] -> Nothing
-- ANCHOR_END: scores

main : IO ()
main = do
  forEach (bonus 5 players) (\p -> putStrLn f"{p.name:<8}{p.score:>4}")
  case top players of
    | Just { name, score } -> putStrLn f"top: {name} ({score})"
    | Nothing -> putStrLn "nobody"
