-- ✍️ Step 1: the widest annotations.
-- ステップ1：いちばん広い型の注釈
--   lam examples/records/answers/annotated.lam

-- ANCHOR: annotated
between : Comparable a => a -> a -> a -> Bool
between lo hi x = lo <= x && x <= hi

older : Comparable a =>
  { r | age : a } -> { r | age : a } -> { r | age : a }
older a b = if a.age >= b.age then a else b

rename : a -> { r | name : a } -> { r | name : a }
rename n r = { r | name = n }
-- ANCHOR_END: annotated

( between 1 9 5
, between "a" "m" "lam"
, (older { name = "Lam", age = 9 } { name = "Go", age = 8 }).name
, rename "LAM" { name = "Lam", days = 9 } )
