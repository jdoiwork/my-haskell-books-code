-- 🧰 The answers of the training: three more tools, written in Lam.
-- トレーニングの解答：Lam で書いた、道具を3つ
module Extra exposing (chunksOf, groupBy, wordWrap)

-- ANCHOR: chunksOf
-- 📦 Step 1: cut into pieces of n. take and drop are Sequence, so it
--    works for strings too:
--      chunksOf 2 [1, 2, 3, 4, 5]  is  [[1, 2], [3, 4], [5]]
--      chunksOf 3 "abcdefg"        is  ["abc", "def", "g"]
-- ステップ1：n 個ずつに切る。take と drop は Sequence なので、文字列にも
let chunksOf n xs =
  if n < 1 || length xs == 0 then []
  else take n xs : chunksOf n (drop n xs)
-- ANCHOR_END: chunksOf

-- ANCHOR: groupBy
-- 🗂️ Step 2: put the items into groups, by a key that f gives. The
--    items of a group keep their order.
--      groupBy (take 1) ["apple", "banana", "avocado"]
--      is  {"a": ["apple", "avocado"], "b": ["banana"]}
-- ステップ2：f がくれるキーで、グループに分ける。グループの中は元の順
let groupBy f xs =
  foldl
    (\groups x ->
       Map.update (f x) (\old -> Just (fromMaybe [] old ++ [x])) groups)
    Map.empty xs
-- ANCHOR_END: groupBy

-- ANCHOR: wordWrap
-- 📝 Step 3: wrap a text into lines of at most width letters (a word
--    longer than that gets a line of its own).
-- ステップ3：文字列を、width 文字までの行に折り返す（それより長い
-- 単語は、1つで1行）
let wordWrap width text =
  let put lines w =
    case lines of
      | [] -> [w]
      | line : rest ->
          if length line + 1 + length w <= width then
            (line ++ " " ++ w) : rest
          else w : line : rest
  in reverse (foldl put [] (words text))
-- ANCHOR_END: wordWrap
