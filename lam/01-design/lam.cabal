cabal-version: 3.0
name:          lam
version:       0.1.0.0
build-type:    Simple

-- 第VII部 プログラミング言語を作る（1. 言語を設計する）

common shared
  default-language: GHC2024
  ghc-options:      -Wall
  build-depends:
    , base             >=4.20 && <5
    , containers       ^>=0.8
    , text             ^>=2.1

library
  import:           shared
  exposed-modules:  Lam.Syntax
                    Lam.Pretty
                    Lam.Examples
                    Lam.Answers
  hs-source-dirs:   src answers

test-suite lam-test
  import:           shared
  type:             exitcode-stdio-1.0
  main-is:          Spec.hs
  hs-source-dirs:   test
  build-depends:
    , lam
    , hspec            ^>=2.11
