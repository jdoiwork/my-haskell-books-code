-- The receipt of the shop: the names to the left, the numbers to the
-- right, with a comma every 3 digits.
-- お店のレシート：名前は左に、数は右にそろえ、3桁ごとにカンマを打つ

-- The price of each item, in yen.
-- 品物ごとの値段（円）
let prices = {sticker: 300, mug: 1200, tshirt: 2500}

-- What was sold today: the item, and how many.
-- 今日売れたもの：品物と、いくつ
let orders = [("sticker", 4), ("mug", 1), ("tshirt", 3)]

let priceOf item = fromMaybe 0 (Map.lookup item prices)

-- ANCHOR: line
-- One line of the receipt.
-- レシートの1行
let line order =
  case order of
    | (item, n) ->
        f"{item:<10}{n:>3} x {priceOf item:>6,} = {n * priceOf item:>9,}"
-- ANCHOR_END: line

let total = sum (map (\o -> snd o * priceOf (fst o)) orders)

let main = do
  -- 「レシート」を真ん中に
  putStrLn f"{"RECEIPT":^34}"
  forEach orders (\o -> putStrLn (line o))
  putStrLn "----------------------------------"
  -- 「合計」
  putStrLn f"{"total":<10}{total:>24,}"
