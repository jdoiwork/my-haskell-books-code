-- 🌡️ The temperatures of a week in winter, in Celsius.
-- 冬の1週間の気温（摂氏）
--   lam examples/float/temps.lam

-- ANCHOR: temps
-- A minus right before a number: a negative number. -1 is a Float
-- here, as the others are.
-- 数の直前のマイナスは、負の数。-1 も、ほかと同じく Float
temps : [Float]
temps = [-3.5, -1, 0.5, 2, -0.5, 4.5, 1]
-- ANCHOR_END: temps

-- ANCHOR: average
-- 📊 The average: the sum, divided by how many. / is for Floats, so
--    the length (an Int) is made a Float first.
-- 平均：合計を数で割る。/ は Float の割り算なので、長さ（Int）を先に
-- Float にする
average : [Float] -> Float
average xs = sum xs / toFloat (length xs)
-- ANCHOR_END: average

-- ANCHOR: fahrenheit
-- 🌡️ Celsius to Fahrenheit: 0 is 32, and -40 is -40.
-- 摂氏を華氏に
fahrenheit : Float -> Float
fahrenheit c = c * 9 / 5 + 32
-- ANCHOR_END: fahrenheit

-- ANCHOR: main
main : IO ()
main = do
  -- 「平均」
  putStrLn f"average {average temps:.2} C"
  -- 「いちばん低い・高い」
  putStrLn f"lowest {minimum temps ?: 0} C, highest {maximum temps ?: 0} C"
  forEach temps (\c -> putStrLn f"{c:>5} C = {fahrenheit c:>5.1} F")
-- ANCHOR_END: main
