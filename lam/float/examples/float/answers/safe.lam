-- 🛟 Step 3: an average and a percentage that never fail.
-- ステップ3：失敗しない平均と割合
--   lam examples/float/answers/safe.lam

-- ANCHOR: safe
-- Nothing for an empty list: /? gives Nothing for 0.
-- 空のリストなら Nothing。/? は 0 で割ると Nothing
average : [Int] -> Maybe Float
average xs = toFloat (sum xs) /? toFloat (length xs)

-- part of whole, in percent with 1 digit; "-" when whole is 0.
-- whole のうちの part を、小数点以下1けたの百分率で。whole が 0 なら "-"
percent : Int -> Int -> String
percent part whole =
  case toFloat part * 100 /? toFloat whole of
    | Nothing -> "-"
    | Just p -> Float.fixed 1 p ++ "%"
-- ANCHOR_END: safe

(average [82, 75, 91, 64] ?: 0, average [] ?: 0, percent 3 4, percent 1 0)
