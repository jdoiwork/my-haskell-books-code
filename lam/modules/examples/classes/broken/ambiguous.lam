-- 🚨 describe of an empty list: a list of what?
-- 空のリストの describe：何のリスト？
--   lam examples/classes/broken/ambiguous.lam

class Describe a where
  describe : a -> String

instance Describe Int where
  describe n = showInt n

instance Describe a => Describe [a] where
  describe xs = "[" ++ join ", " (map describe xs) ++ "]"

-- ANCHOR: main
describe []
-- ANCHOR_END: main
