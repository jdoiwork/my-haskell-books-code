-- ANCHOR: all
-- ANCHOR: header
-- 📚 Words: cut a text into words, count them, and rank them.
--    The tools of wordfreq.lam, in a file of their own.
-- Words：文字列を単語に分け、数え、順位を付ける。
-- wordfreq.lam の道具を、自分のファイルに
module Words exposing (splitIntoWords, countWords, topN)
-- ANCHOR_END: header

-- ✂️ Split text into lowercase words. Anything that is not a letter
--    separates words: "Hello, world!" gives ["hello", "world"].
-- 文字列を、小文字の単語に分ける。文字でないものは、単語の区切り
let splitIntoWords text =
  text
    |> toLower
    |> Regex.findAll re"\p{L}+"
    |> map Match.text

-- ANCHOR: helper
-- ➕ One more of the word w. Only this file uses it: it is not in
--    the exposing list above.
-- 単語 w を1つ数える。使うのはこのファイルだけなので、上の exposing の
-- 一覧には書かない
let addOne counts w = Map.insertWith (\new old -> new + old) w 1 counts
-- ANCHOR_END: helper

-- 🔢 Count how many times each word appears: {"a": 2, "b": 1}
-- 単語ごとの出現回数を数える
let countWords ws = foldl addOne Map.empty ws

-- 🏆 Take the n most frequent words. sortOn keeps the order of the
--    words with the same count (the order of the Map: a to z).
-- 出現回数の多い順に n 個取り出す。
-- 同じ回数の単語は、Map の順（a から z）のまま
let topN n counts =
  Map.toList counts
    |> sortOn (\pair -> 0 - snd pair)
    |> take n
-- ANCHOR_END: all
