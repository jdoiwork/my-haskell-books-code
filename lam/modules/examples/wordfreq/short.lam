-- ANCHOR: all
-- Step 1 of the training: wordfreq with a short name for Words,
-- and topN without any name in front.
-- トレーニングのステップ1：Words に短い別名を付け、topN は名前なしで
import Words as W exposing (topN)

let main = do
  text <- getContents
  let ranking = text |> W.splitIntoWords |> W.countWords |> topN 3
  forEach ranking (\pair -> putStrLn f"{fst pair:<12}{snd pair}")
-- ANCHOR_END: all
