-- ANCHOR: all
-- Step 2 of the training: a percent is from 0 to 100. The constructor
-- is hidden, so a percent out of range cannot be made.
-- トレーニングのステップ2：パーセントは 0 から 100。構成子を隠すので、
-- 範囲の外のパーセントは作れない
module Percent exposing (Percent, fromInt, toInt, add, bar)

data Percent = Percent Int

-- A percent, if n is from 0 to 100.
-- n が 0 から 100 なら、パーセント
let fromInt n = if n < 0 || n > 100 then Nothing else Just (Percent n)

let toInt p = case p of | Percent n -> n

-- Two percents added, but never over 100.
-- 2つを足す。ただし 100 を超えない
let add a b = Percent (min 100 (toInt a + toInt b))

-- A bar of 10 marks: 70 percent is "#######...".
-- 10個の印の棒グラフ
let bar p =
  let full = toInt p / 10 in
  foldl (\s i -> s ++ (if i <= full then "#" else ".")) "" (range 1 10)
-- ANCHOR_END: all
