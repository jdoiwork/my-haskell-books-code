-- 🏆 The results of the quiz: a name and the scores of each round
--    (someone may have no score yet).
-- クイズ大会の結果：名前と、各回の点数（まだ点数のない人もいる）
--   lam examples/stdlib/quiz.lam

-- ANCHOR: book
-- 📒 Who got what, as a Map from the name to the scores.
-- 誰が何点だったか。名前から点数への Map
book =
  Map.fromList
    [ ("Python", [82, 75, 90])
    , ("TS", [68, 91])
    , ("Rust", [95, 88, 79])
    , ("Ruby", [])
    , ("Erlang", [55, 61, 40]) ]
-- ANCHOR_END: book

-- ANCHOR: best
-- 🥇 The best score, or "-" when there is none yet (maximum gives
--    Nothing for an empty list).
-- いちばんよい点。まだなければ「-」（空のリストの maximum は Nothing）
best scores =
  case maximum scores of
    | Just s -> showInt s
    | Nothing -> "-"
-- ANCHOR_END: best

-- ANCHOR: totals
-- ➕ map works on a Map too: the total of each one. maximum and sum
--    work on the values of a Map.
-- map は Map にも効く：1人ずつの合計。maximum も sum も、Map の値に効く
totals = map sum book

bestTotal = maximum totals ?: 0

allPoints = sum totals
-- ANCHOR_END: totals

-- ANCHOR: passed
-- ✅ Passed: has a score, and every score is 60 or more.
-- 合格：点数があって、どの点も 60 以上
passed scores = not (null scores) && all (\s -> s >= 60) scores
-- ANCHOR_END: passed

-- ANCHOR: ranking
-- 📋 "1. Rust 262", ...: the biggest total first, numbered from 1
--    (indexed numbers them from 0).
-- 合計の大きい順に、1 から番号を付ける（indexed は 0 から）
ranking =
  Map.toList totals
    |> sortOn (\(name, total) -> -total)
    |> indexed
    |> map (\(i, (name, total)) ->
              showInt (i + 1) ++ ". " ++ name ++ " " ++ showInt total)

-- 🚦 Those who passed, and those who did not yet.
-- 合格した人と、まだの人
groups = partition (\(name, scores) -> passed scores) (Map.toList book)

passedNames = map fst (fst groups)

notYet = map fst (snd groups)
-- ANCHOR_END: ranking

-- ANCHOR: pretty
-- 📌 The totals as JSON, on many lines, for the notice board.
-- 合計を JSON で、掲示板に貼れるよう、何行かに分けて
notice = Json.pretty (JObj (map JInt totals))
-- ANCHOR_END: pretty

ranking
