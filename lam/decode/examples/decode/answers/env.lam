-- Step 2 of the training: a .env file, read into a record.
-- トレーニングのステップ2：.env のファイルを、レコードに読む

-- 📄 KEY=value lines; # lines and empty lines are left out.
-- KEY=value の行。# の行と空の行はとばす
pairs : String -> Map String String
pairs text =
  Map.fromList
    [ (String.trim k, String.trim (join "=" vs))
    | line <- lines text
    , not (String.startsWith "#" (String.trim line))
    , String.trim line /= ""
    , k : vs <- [String.split "=" line] ]

-- 🔧 The values are strings: read them with the Columns of Csv.
-- 値は文字。Csv の Column で読む
columns : Map String Column
columns = {"PORT": Csv.int, "DEBUG": Csv.bool}

asJson : Map String String -> Result [Problem] Json
asJson m =
  Result.map (\kvs -> JObj (Map.fromList kvs))
    (Decode.collect (map entry (Map.toList m)))
  where
    -- One value, read by its column (a string if it has none).
    -- 値1つを、その列の読み方で（なければ文字のまま）
    entry (k, v) =
      case Map.lookup k columns of
        | Nothing -> Ok (k, JStr v)
        | Just c ->
            case c v of
              | Ok j -> Ok (k, j)
              | Err e -> Err [{ path = Decode.keyStep k, message = e }]

type alias Settings = { port : Int, debug : Bool }

settings : Decoder Settings
settings =
  Decode.map2 (\p d -> { port = p, debug = d })
    (Decode.field "PORT" Decode.int)
    (Decode.field "DEBUG" Decode.bool)

read : String -> Result [Problem] Settings
read text = asJson (pairs text) |> Result.andThen (Decode.run settings)

good = "# the shop\nPORT=8080\nDEBUG = true\n\nNAME=Lam Shop\n"
bad = "PORT=eighty\nDEBUG=yes\n"

main : IO ()
main =
  forEach [good, bad] (\text ->
    case read text of
      | Ok s -> putStrLn f"port {s.port}, debug {s.debug}"
      | Err ps -> putStrLn (Decode.explain ps))
