cabal-version: 3.0
name:          lam
version:       0.17.0.0
build-type:    Simple

-- 第8部 プログラミング言語を作る（17. ワンライナーで動かす：Perl のように）

common shared
  default-language: GHC2024
  ghc-options:      -Wall
  build-depends:
    , base             >=4.20 && <5
    , containers       ^>=0.8
    , text             ^>=2.1

-- ANCHOR: lib
library
  import:           shared
  exposed-modules:  Lam.Syntax
                    Lam.Pretty
                    Lam.Examples
                    Lam.Parser
                    Lam.Eval
                    Lam.Types
                    Lam.Program
                    Lam.Module
                    Lam.Data
                    Lam.Builtins
                    Lam.Json
                    Lam.Io
                    Lam.Format
                    Lam.Pcre
                    Lam.Regex
                    Lam.Parsing
                    Lam.Outside
                    Lam.Sqlite
                    Lam.Guard
                    Lam.OneLiner
                    Lam.Script
                    Lam.World
                    Lam.Prelude
                    Lam.Repl
                    -- The answers of the training
                    -- トレーニングの解答
                    Lam.Answers
  hs-source-dirs:   src answers
  -- ANCHOR: deps
  build-depends:
    , megaparsec         ^>=9.8
    , parser-combinators ^>=1.3
    , aeson              ^>=2.3
    , attoparsec         ^>=0.14
    , attoparsec-aeson   ^>=2.2
    , scientific         ^>=0.3
    , vector             ^>=0.13
    -- For the State of the fake world, and the Reader of the parser
    -- 偽物の世界の State と、パーサーの Reader のため
    , mtl                ^>=2.3
    -- Regular expressions (PCRE2, the C library comes inside)
    -- 正規表現（PCRE2。C のライブラリが中に入っている）
    , pcre2              ^>=2.3
    -- To search to the end at once, and catch a mistake there
    -- 探すのを一度に最後までやり、そこで起きたまちがいを受け止めるため
    , deepseq            ^>=1.5
    -- To find the files of modules, and to load each once
    -- モジュールのファイルを探し、それぞれ1度だけ読むため
    , filepath           ^>=1.5
    , directory          ^>=1.3
    , transformers       ^>=0.6
    -- HTTP (with TLS for https), and SQLite
    -- HTTP（https のための TLS も）と SQLite
    , http-client        ^>=0.7.19
    , http-client-tls    ^>=0.3.6
    , http-types         ^>=0.12
    , case-insensitive   ^>=1.2
    , bytestring         ^>=0.12
    , direct-sqlite      ^>=2.3.29
  -- ANCHOR_END: deps
-- ANCHOR_END: lib

-- ANCHOR: exe
executable lam
  import:           shared
  main-is:          Main.hs
  hs-source-dirs:   app
  build-depends:
    , lam
    , haskeline        ^>=0.8
-- ANCHOR_END: exe

test-suite lam-test
  import:           shared
  type:             exitcode-stdio-1.0
  main-is:          Spec.hs
  hs-source-dirs:   test
  build-depends:
    , lam
    , hspec            ^>=2.11
    , megaparsec       ^>=9.8
    , QuickCheck       ^>=2.19
    , aeson            ^>=2.3
    , scientific       ^>=0.3
    , vector           ^>=0.13
    , directory        ^>=1.3
    , filepath         ^>=1.5
    , mtl              ^>=2.3
