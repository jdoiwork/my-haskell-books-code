#!/usr/bin/env lam
-- 📜 The same as this one-liner (made with lam --script):
-- このワンライナーと同じ動きのスクリプト（lam --script で作った）：
--   lam -a -n --begin '0' -e 'acc + toIntOr 0 (field 2)' --end 'print'
-- Run it:  lam this.lam [files...]   (no files: the standard input)
-- 動かし方：lam このファイル.lam [ファイル…]（なければ標準入力）

-- 🔢 field n is the column n: 1 is the first, 0 the whole line,
--    and a column that is not there is "".
-- field n は n 列目。1 が1列目、0 は行全体、ない列は ""
let fieldOf line fields n =
  if n == 0 then line
  else if n < 0 then ""
  else case drop (n - 1) fields of
    | x : _ -> x
    | [] -> ""

-- 🔁 The program of -e, for one line.
-- -e のプログラム。line を1つ受け取る
let step acc line =
  let fields = words line in
  let field = fieldOf line fields in
  acc + toIntOr 0 (field 2)

-- 🌱 --begin: the first acc. / 初めの acc
let start =
  0

-- 🏁 --end: what to do with the last acc. / 最後の acc ですること
let finish acc =
  (
    print
  ) acc

-- 🧩 A line is one piece. / 1行が1つ分
let piecesOf place text = Ok [text]

-- 👣 One piece: give the acc for the next one.
-- 1つ分をやって、次の1つ分のための acc を返す
let visit acc piece = pure (step acc piece)

let visitAll acc pieces =
  case pieces of
    | [] -> pure acc
    | piece : rest -> do
        next <- visit acc piece
        visitAll next rest

-- 🛑 Stop with a message, and the exit code 1.
-- わけを言って、終了コード 1 で止まる
let stop message = do
  ePutStrLn f"error: {message}"
  exit 1

let orStop result =
  case result of
    | Ok x -> pure x
    | Err message -> stop message

-- 📥 The standard input, one line at a time.
-- 標準入力を、1行ずつ
let fromStdin acc n = do
  next <- getLine
  case next of
    | Nothing -> pure acc
    | Just line -> do
        pieces <- orStop (piecesOf f"<stdin>:{n}" line)
        acc2 <- visitAll acc pieces
        fromStdin acc2 (n + 1)

let fromLines acc file n ls =
  case ls of
    | [] -> pure acc
    | line : rest -> do
        pieces <- orStop (piecesOf f"{file}:{n}" line)
        acc2 <- visitAll acc pieces
        fromLines acc2 file (n + 1) rest

-- 📂 The files, one after another.
-- ファイルを、順に
let fromFiles acc files =
  case files of
    | [] -> pure acc
    | file : rest -> do
        read <- readFile file
        text <- orStop read
        acc2 <- fromLines acc file 1 (lines text)
        fromFiles acc2 rest

-- 🚪 The files, or the standard input when there are none.
-- ファイル、なければ標準入力
let main files = do
  last <- if null files then fromStdin start 1 else fromFiles start files
  finish last
