-- ANCHOR: all
-- 🧾 shop.lam, with an error type of our own: each ? first turns the
--    error into a ShopError with Result.mapError.
-- 自分のエラーの型を使う shop.lam。? の前に、Result.mapError で
-- エラーを ShopError にする
--   LAM_PATH=examples/modules/receipt lam examples/errors/answers/typed.lam
import Receipt

-- 🏷️ The price of each item, in yen.
-- 品物ごとの値段（円）
prices = {sticker: 300, mug: 1200, tshirt: 2500}

-- 📦 One order in the JSON:  {"item": "mug", "count": 1}.
-- JSON の注文1つ
orderOf : Json -> Maybe (String, Int)
orderOf j = do
  item  <- Json.get "item" j |> Maybe.andThen Json.string
  count <- Json.get "count" j |> Maybe.andThen Json.int
  pure (item, count)

-- 🧾 From the text of the file to the lines of the receipt.
--    A do of Result stops at the first Err by itself: no ? here.
-- ファイルの文字から、レシートの行へ。Result の do は、最初の Err で
-- ひとりでに止まる。ここに ? は要らない
receiptOf : String -> Result String [String]
receiptOf text = do
  json   <- Json.parse text
  -- 「注文はリストでなければなりません」
  items  <- Json.array json |> Result.fromMaybe "the orders must be a list"
  -- 「注文には item と count が要ります」
  orders <- mapM orderOf items
              |> Result.fromMaybe "each order needs an item and a count"
  pure (Receipt.receipt prices orders)

-- ANCHOR: main
-- 🧯 What went wrong, and where.
-- 何がまずかったか、どこで
data ShopError = NoOrders String | BadOrders String | CannotSave String

main : IO (Result ShopError ())
main = do
  text  <- readFile "examples/errors/orders.json"
             |> map (Result.mapError NoOrders) ?
  lines <- pure (receiptOf text |> Result.mapError BadOrders) ?
  forEach lines putStrLn
  writeFile "receipt.txt" (join "\n" lines ++ "\n")
    |> map (Result.mapError CannotSave) ?
  pure (Ok ())
-- ANCHOR_END: main
-- ANCHOR_END: all
