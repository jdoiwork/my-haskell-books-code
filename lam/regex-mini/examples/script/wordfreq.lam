#!/usr/bin/env lam
-- 🚀 wordfreq in Lam: show the 10 most frequent words of a text.
--      lam wordfreq.lam sample.txt     (a file)
--      lam wordfreq.lam < sample.txt   (the standard input)
-- Lam で書いた wordfreq：文字列の中で、よく出てくる単語のトップ10を表示する

-- ANCHOR: split
-- 🔤 A letter stays, anything else becomes a space: "," gives " ".
-- 文字はそのまま、ほかは空白に
replaceNonLetter : String -> String
replaceNonLetter c = if String.isLetter c then c else " "

-- ✂️ Split text into lowercase words. Anything that is not a letter
--    separates words: "Hello, world!" gives ["hello", "world"].
-- 文字列を、小文字の単語に分ける。文字でないものは、単語の区切り
splitIntoWords : String -> [String]
splitIntoWords text =
  text
    |> chars
    |> map replaceNonLetter
    |> join ""
    |> toLower
    |> words
-- ANCHOR_END: split

-- ANCHOR: count
-- 🔢 Count how many times each word appears: {"a": 2, "b": 1}
-- 単語ごとの出現回数を数える
countWords : [String] -> Map String Int
countWords ws =
  foldl (\counts w -> Map.insertWith (+) w 1 counts) Map.empty ws

-- 🏆 Take the n most frequent words. sortOn keeps the order of the
--    words with the same count (the order of the Map: a to z).
-- 出現回数の多い順に n 個取り出す。
-- 同じ回数の単語は、Map の順（a から z）のまま
topN : Int -> Map String Int -> [(String, Int)]
topN n counts =
  Map.toList counts
    |> sortOn (\(_, count) -> -count)
    |> take n
-- ANCHOR_END: count

-- ANCHOR: print
-- 🖨️ A word (padded to 12 letters) and its count: "the         6"
-- 単語（12文字の幅に左寄せ）と出現回数
printEntry : (String, Int) -> IO ()
printEntry (word, count) = putStrLn f"{word:<12}{count}"
-- ANCHOR_END: print

-- ANCHOR: input
-- 📥 The text: the file in the arguments, or the standard input.
--    More than one file: how to use it, and exit code 2.
-- 文字列：引数のファイルか、標準入力。ファイルが2つ以上なら、
-- 使い方を書いて、終了コード 2
readInput : [String] -> IO (Result String String)
readInput args =
  case args of
    | [] -> getContents |> IO.andThen (\text -> pure (Ok text))
    | [file] -> readFile file
    | _ -> do
        -- 「使い方：wordfreq [ファイル]」
        ePutStrLn "usage: wordfreq [FILE]"
        exit 2
-- ANCHOR_END: input

-- ANCHOR: main
-- 🚪 The arguments come to main. A file that cannot be read goes back
--    with ?: the error goes to the standard error, with exit code 1.
-- 引数は main に来る。読めないファイルは ? で返る：エラーは標準エラーへ、
-- 終了コードは 1
main : [String] -> IO (Result String ())
main args = do
  text <- readInput args ?
  let ranking = text |> splitIntoWords |> countWords |> topN 10
  forEach ranking printEntry
  pure (Ok ())
-- ANCHOR_END: main
