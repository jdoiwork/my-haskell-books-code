-- Ask for a name, and greet. The program starts at main.
-- 名前を聞いて、あいさつする。プログラムは main から始まる

let main = do
  -- 「お名前は？」
  putStr "What is your name? "
  answer <- getLine
  case answer of
    -- 「さようなら！」（名前を打たずに終わった）
    | Nothing -> putStrLn "Goodbye!"
    | Just name -> do
        -- 「こんにちは、○○さん！」「お名前は○文字です」
        putStrLn ("Hello, " ++ name ++ "!")
        putStrLn ("Your name has " ++ showInt (length name) ++ " letters.")
