-- 🍰 Split the bill of the snack time.
-- おやつどきの代金を割り勘にする
--   lam examples/float/split.lam

-- ANCHOR: split
bill : Int
bill = 2490

-- ✂️ Each one's share, in whole yen (and what is left), or Nothing for
--    nobody. //? gives Nothing when it divides by 0.
-- 1人ぶん（円の整数）と余り。だれもいなければ Nothing
share : Int -> Maybe (Int, Int)
share n = Maybe.map (\each -> (each, bill - each * n)) (bill //? n)

-- 🧮 The exact share, rounded in the three ways of a half.
-- ぴったりの1人ぶんを、半分の3つの丸め方で
exact : Int -> String
exact n =
  case toFloat bill /? toFloat n of
    | Nothing -> "no share"
    | Just x -> f"{x:.2} -> {join ", " (map (\r -> showInt (r x ?: 0)) ways)}"
  where
    ways = [round, Float.roundTiesEven, Float.roundTiesUp]
-- ANCHOR_END: split

-- ANCHOR: main
main : IO ()
main = forEach [4, 7, 0] (\n -> do
  case share n of
    | Just (each, rest) -> putStrLn f"{n} people: {each} yen, {rest} left"
    | Nothing -> putStrLn f"{n} people: nobody to pay"
  putStrLn f"  exactly {exact n}")
-- ANCHOR_END: main
