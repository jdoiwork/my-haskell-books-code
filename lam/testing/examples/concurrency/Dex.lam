-- ANCHOR: all
-- 📖 A small picture book of PokeAPI: the number and the Japanese name
--    of a Pokémon, from its English name. One request for each.
-- PokeAPI の小さな図鑑：英語の名前から、ポケモンの番号と日本語の名前を。
-- 1匹に1回の頼みごと
module Dex exposing (Mon, fetch, line)

-- ANCHOR: mon
-- 🏷️ What we keep of one Pokémon.
-- 1匹について持っておくもの
type alias Mon = { id : Int, name : String, ja : String }
-- ANCHOR_END: mon

api : String
api = "https://pokeapi.co/api/v2/pokemon-species/"

-- 🔤 The Japanese name, from the names of the species.
-- 種族の名前の一覧から、日本語の名前を
japanese : Decoder String
japanese =
  Decode.field "names" (Decode.list named)
    |> Decode.andThen (\names ->
         case [ n | (lang, n) <- names, lang == "ja" ] of
           | n : _ -> Decode.succeed n
           | [] -> Decode.fail "no name in Japanese")
  where
    named =
      Decode.map2 (\lang n -> (lang, n))
        (Decode.at ["language", "name"] Decode.string)
        (Decode.field "name" Decode.string)

-- 🔍 The number and the Japanese name of one species.
-- 種族1つの、番号と日本語の名前
species : String -> Decoder Mon
species name = do
  id <- Decode.field "id" Decode.int
  ja <- japanese
  pure { id = id, name = name, ja = ja }

-- ANCHOR: fetch
-- 🌐 Ask PokeAPI about one Pokémon. An Err says why not.
-- PokeAPI に1匹のことを聞く。だめなら Err にわけ
fetch : String -> IO (Result String Mon)
fetch name = do
  answer <- Http.getAs (species name) (api ++ name)
  pure (Result.mapError (\e -> f"{name}: {e}") answer)
-- ANCHOR_END: fetch

-- 📝 One line for the screen:  #25    ピカチュウ (pikachu)
-- 画面に出す1行
line : Mon -> String
line m = f"#{m.id:<4} {m.ja} ({m.name})"
-- ANCHOR_END: all
