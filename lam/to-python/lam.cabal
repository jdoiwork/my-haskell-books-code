cabal-version: 3.0
name:          lam
version:       0.32.0.0
build-type:    Simple
-- ANCHOR: runtimeFile
-- The runtimes of lam to-js and lam to-python, put inside lam (Lam.ToJs,
-- Lam.ToPython).
-- lam to-js と lam to-python のランタイム。lam の中に入れる
extra-source-files: runtime/lam.mjs
                    runtime/lam.py
-- ANCHOR_END: runtimeFile

-- 第16部 Lam を仕上げる（9. Python に変換する）

common shared
  default-language: GHC2024
  ghc-options:      -Wall
  build-depends:
    , base             >=4.20 && <5
    , containers       ^>=0.8
    , text             ^>=2.1

-- ANCHOR: lib
library
  import:           shared
  exposed-modules:  Lam.Syntax
                    Lam.Pretty
                    Lam.Examples
                    Lam.Parser
                    Lam.Eval
                    Lam.Types
                    Lam.Program
                    Lam.Data
                    Lam.Builtins
                    Lam.Prelude
                    Lam.Repl
                    Lam.Sugar
                    Lam.Float
                    Lam.Class
                    Lam.Json
                    Lam.Stdlib
                    Lam.Format
                    Lam.Module
                    Lam.Io
                    Lam.World
                    Lam.Clock
                    Lam.Files
                    Lam.Utf8
                    Lam.Bytes
                    Lam.Pcre
                    Lam.Regex
                    Lam.Parsing
                    Lam.Decode
                    Lam.Outside
                    Lam.Sqlite
                    Lam.Guard
                    Lam.Cli
                    Lam.Shell
                    Lam.OneLiner
                    Lam.Concurrent
                    Lam.Scheduler
                    Lam.Channels
                    Lam.Server
                    Lam.Bundle
                    Lam.Toolbox
                    Lam.Settings
                    Lam.Testing
                    Lam.TestRun
                    Lam.Check
                    Lam.Lsp
                    Lam.Core
                    -- ANCHOR: toPythonModules
                    Lam.Backend
                    Lam.ToJs
                    Lam.ToPython
                    -- ANCHOR_END: toPythonModules
                    -- The answers of the training
                    -- トレーニングの解答
                    Lam.Answers
  hs-source-dirs:   src answers
  -- ANCHOR: deps
  build-depends:
    , megaparsec         ^>=9.8
    , parser-combinators ^>=1.3
    , mtl                ^>=2.3
    , aeson              ^>=2.3
    , attoparsec         ^>=0.14
    , attoparsec-aeson   ^>=2.2
    , scientific         ^>=0.3
    , vector             ^>=0.13
    -- Json.pretty
    , aeson-pretty       ^>=0.8
    -- import: the files of modules, and LAM_PATH
    -- import：モジュールのファイルと、LAM_PATH
    , filepath           ^>=1.5
    , directory          ^>=1.3
    , transformers       ^>=0.6
    -- ANCHOR: filesDeps
    -- The clock, commands, globs (logs/*.log), and dice.
    -- 時計、コマンド、glob（logs/*.log）、さいころ
    , time               ^>=1.15
    , process            ^>=1.6
    , Glob               ^>=0.10
    , random             ^>=1.3
    -- ANCHOR_END: filesDeps
    -- ANCHOR: bytesDeps
    -- Bytes, SHA-256, and base64.
    -- バイト列、SHA-256、base64
    , bytestring         ^>=0.12
    , cryptohash-sha256  ^>=0.11.102
    , base64-bytestring  ^>=1.2
    , base16-bytestring  ^>=1.0
    -- ANCHOR_END: bytesDeps
    -- ANCHOR: regexDeps
    -- Regular expressions (PCRE2, the C library comes inside)
    -- 正規表現（PCRE2。C のライブラリが中に入っている）
    , pcre2              ^>=2.3
    -- To search to the end at once, and catch a mistake there
    -- 探すのを一度に最後までやり、そこで起きたまちがいを受け止めるため
    , deepseq            ^>=1.5
    -- ANCHOR_END: regexDeps
    -- ANCHOR: decodeDeps
    -- CSV (RFC 4180) and TOML (1.1)
    -- CSV（RFC 4180）と TOML（1.1）
    , cassava            ^>=0.5
    , toml-parser        ^>=2.0
    -- ANCHOR_END: decodeDeps
    -- ANCHOR: outsideDeps
    -- HTTP (with TLS for https), and SQLite
    -- HTTP（https のための TLS も）と SQLite
    , http-client        ^>=0.7.19
    , http-client-tls    ^>=0.3.6
    , http-types         ^>=0.12
    , case-insensitive   ^>=1.2
    , direct-sqlite      ^>=2.3.29
    -- ANCHOR_END: outsideDeps
    -- ANCHOR: asyncDep
    -- To do several requests at once (threads, cancelled together)
    -- いくつもの頼みごとを同時にやるため（スレッドを、まとめて取り消せる）
    , async              ^>=2.2
    -- ANCHOR_END: asyncDep
    -- ANCHOR: stmDep
    -- Channels and mailboxes: values that jobs share, changed together
    -- (software transactional memory)
    -- チャネルと受け箱：仕事どうしで分け合い、まとめて書き換える値
    -- （ソフトウェアトランザクショナルメモリー）
    , stm                ^>=2.5
    -- ANCHOR_END: stmDep
    -- ANCHOR: serverDeps
    -- A web server (the same as the chapter of the web API)
    -- Web サーバー（Web API の章と同じもの）
    , warp               ^>=3.4
    , wai                ^>=3.2
    -- ANCHOR_END: serverDeps
    -- ANCHOR: toJsDeps
    -- lam to-js: the JavaScript laid out, and the runtime put inside lam
    -- lam to-js：JavaScript を整えて書き、ランタイムを lam の中に入れる
    , prettyprinter      ^>=1.7
    , file-embed         ^>=0.0.16
    -- ANCHOR_END: toJsDeps
  -- ANCHOR_END: deps
-- ANCHOR_END: lib

-- ANCHOR: exe
executable lam
  import:           shared
  main-is:          Main.hs
  hs-source-dirs:   app
  -- The version for lam --version.
  -- lam --version のための版
  other-modules:    Paths_lam
  autogen-modules:  Paths_lam
  -- +RTS -s: how much memory a script took (see the morning's log).
  -- +RTS -s：スクリプトがどれだけメモリを使ったか（朝のログで見る）
  -- ANCHOR: threaded
  -- The threaded runtime: a command or SQLite that waits does not
  -- stop the other threads.
  -- スレッドの実行時システム：待っているコマンドや SQLite が、ほかの
  -- スレッドを止めない
  ghc-options:      -rtsopts -threaded
  -- ANCHOR_END: threaded
  build-depends:
    , lam
    , haskeline        ^>=0.8
    , filepath         ^>=1.5
    -- lam --check --json
    , aeson            ^>=2.3
    , bytestring       ^>=0.12
-- ANCHOR_END: exe

test-suite lam-test
  import:           shared
  type:             exitcode-stdio-1.0
  main-is:          Spec.hs
  hs-source-dirs:   test
  ghc-options:      -threaded
  build-depends:
    , lam
    , hspec            ^>=2.11
    , megaparsec       ^>=9.8
    , QuickCheck       ^>=2.19
    , aeson            ^>=2.3
    , scientific       ^>=0.3
    , vector           ^>=0.13
    , filepath         ^>=1.5
    , directory        ^>=1.3
    , mtl              ^>=2.3
    , time             ^>=1.15
    , random           ^>=1.3
    , bytestring       ^>=0.12
    , cryptohash-sha256 ^>=0.11.102
    , process          ^>=1.6
