-- ANCHOR: all
-- 🔐 Knock on each door of the outside world, and show the answer.
--      lam --allow-read examples/guard/peek.lam
-- 外の世界の扉を1つずつたたいて、答えを見せる

-- 📣 "readFile: ok", or the reason of the Err
-- 「ok」か、Err のわけ
tell : String -> Result String a -> IO ()
tell name result =
  case result of
    | Ok _  -> putStrLn f"{name}: ok"
    | Err e -> putStrLn f"{name}: {e}"

main : IO ()
main = do
  file <- readFile "examples/guard/data/note.txt"
  tell "readFile" file
  saved <- writeFile "peek.txt" "hello"
  tell "writeFile" saved
  removed <- File.remove "peek.txt"
  tell "File.remove" removed
  web <- Http.get "https://pokeapi.co/api/v2/pokemon/pikachu"
  tell "Http.get" web
  db <- Sql.open "peek.db"
  tell "Sql.open" db
  memory <- Sql.open ":memory:"
  tell "Sql.open :memory:" memory
-- ANCHOR_END: all
