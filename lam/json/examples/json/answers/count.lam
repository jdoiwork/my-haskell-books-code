-- 🧮 Step 1 of the training: count the words with a Map.
-- トレーニングのステップ1：Map で単語を数える
--   lam examples/json/answers/count.lam

-- Each word, and how many times it is in the list.
-- 単語ごとに、リストに何回あるか
count : [String] -> Map String Int
count ws = foldl (\m w -> Map.insertWith (+) w 1 m) {} ws

-- The pair (word, count) with the largest count.
-- 数のいちばん大きな（単語, 数）の組
best : Map String Int -> (String, Int)
best m =
  foldl
    (\(w, n) (w2, n2) -> if n2 > n then (w2, n2) else (w, n))
    ("", 0)
    (Map.toList m)

ws = ["the", "cat", "and", "the", "hat", "and", "the", "bat"]

(count ws, best (count ws))
