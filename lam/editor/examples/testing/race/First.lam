#!/usr/bin/env lam
-- ANCHOR: all
-- 🏁 Two jobs answer at the same moment. Which one is first?
--    (first.lam of the chapter on channels, as a module.)
--      lam First.lam
-- 2つの仕事が、同じ瞬間に答える。どちらが先？
-- （チャネルの章の first.lam を、モジュールにした）
module First exposing (main)

main : IO ()
main = do
  c <- Chan.new 0
  _ <- spawn (Chan.send c "left")
  _ <- spawn (Chan.send c "right")
  winner <- Chan.recv c
  putStrLn f"first: {winner ?: "nobody"}"
-- ANCHOR_END: all
