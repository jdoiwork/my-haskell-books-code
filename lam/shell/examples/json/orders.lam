-- 🛒 How many of each item the workshop's shop sold, from the orders
--    in JSON.
-- 工房のお店で、品物ごとにいくつ売れたか。注文の JSON から数える
--   lam examples/json/orders.lam

orders =
  "[{\"item\": \"sticker\", \"count\": 4},"
  ++ " {\"item\": \"mug\", \"count\": 1},"
  ++ " {\"item\": \"sticker\", \"count\": 2}]"

-- 🔎 A field of an object, turned into a Lam value (Nothing if it is
--    not there).
-- オブジェクトの項目を、Lam の値にする（なければ Nothing）
field name convert j = Maybe.andThen convert (Json.get name j)

-- 📦 One order: the item and how many. Nothing if the JSON has another
--    shape.
-- 注文1つ：品物といくつか。JSON の形がちがえば Nothing
order j =
  case (field "item" Json.string j, field "count" Json.int j) of
    | (Just item, Just n) -> Just (item, n)
    | _ -> Nothing

-- ➕ Add up the counts of each item in a Map.
-- 品物ごとの数を、Map に足していく
tally : [Json] -> Map String Int
tally js =
  foldl
    (\totals j ->
      case order j of
        | Just (item, n) -> Map.insertWith (+) item n totals
        | Nothing -> totals)
    {}
    js

-- 📣 The report, written back as JSON.
-- 報告を、JSON に書き戻す
report text =
  case Json.parse text of
    | Err e -> "bad JSON: " ++ e
    | Ok doc ->
      case Json.array doc of
        | Nothing -> "not a list of orders"
        | Just js -> Json.show (JObj (Map.map JInt (tally js)))

(report orders, report "[{\"item\": \"mug\"")
