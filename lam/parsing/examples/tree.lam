-- Step 3 of the training: a binary search tree, and sort with it.
-- トレーニングのステップ3：二分探索木と、それを使った並べ替え
data Tree a = Leaf | Node (Tree a) a (Tree a)

-- Smaller values go to the left, the others to the right.
-- 小さい値は左へ、それ以外は右へ
let insert x t =
  case t of
    | Leaf -> Node Leaf x Leaf
    | Node l v r if x < v -> Node (insert x l) v r
    | Node l v r -> Node l v (insert x r)

-- Left, the value, then right: the values in order.
-- 左、値、右の順に読むと、小さい順になる
let toList t =
  case t of
    | Leaf -> []
    | Node l v r -> toList l ++ [v] ++ toList r

let sort xs = toList (foldr insert Leaf xs)

(sort [5, 3, 8, 1, 4], sort ["Rust", "Go", "Python"])
