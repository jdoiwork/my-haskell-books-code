-- The first parsers of the chapter: load them into the REPL with
--   :load examples/pair.lam
-- 章の最初のパーサー。REPL に :load で読みこんで使う

-- ANCHOR: check
-- Read the text with p, and show the value, or the error as it is.
-- p で読み、値か、エラーをそのまま見せる
let check p text =
  case Parser.run p text of
    | Ok v -> putStrLn (show v)
    | Err e -> putStrLn e
-- ANCHOR_END: check

-- ANCHOR: pair
-- (12, 34): a pair of numbers, with spaces after the comma.
-- 数の組。カンマのあとに空白があってもよい
let pair = Parser.do
  _ <- Parser.string "("
  a <- Parser.int
  _ <- Parser.string ","
  _ <- Parser.spaces
  b <- Parser.int
  _ <- Parser.string ")"
  Parser.pure (a, b)
-- ANCHOR_END: pair

-- ANCHOR: dated
-- date: 2026-11-17, with the date read by a regex.
-- 日付を正規表現で読む
let dated = Parser.do
  _ <- Parser.string "date: "
  m <- Parser.regex re"(?<y>\d{4})-(?<m>\d\d)-(?<d>\d\d)"
  Parser.pure (Match.named "m" m)
-- ANCHOR_END: dated

Parser.run pair "(12, 34)"
