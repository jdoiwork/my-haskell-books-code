-- Step 3 of the training: read a settings file with [sections] into a
-- map of maps. Comments (#) and empty lines are skipped. Each line is
-- read with a regex, and the lines are put together with a parser.
-- トレーニングのステップ3：[セクション] のある設定ファイルを、Map の
-- Map に読む。コメント（#）と空の行は飛ばす。1行ずつは正規表現で読み、
-- 行の並びはパーサーで組み立てる

let settings = join "\n"
  [ "# the settings of the shop"
  , "[shop]"
  , "name = Lam Shop"
  , "  open=9"
  , ""
  , "[stock]"
  , "mug   =  12  "
  , "# no more stickers"
  , "sticker = 0" ]

-- The named group, or "" (the regexes below always have it).
-- 名前付きのグループ。なければ ""（下の正規表現には、いつもある）
let part name m = fromMaybe "" (Match.named name m)

-- An empty line, or a comment.
-- 空の行か、コメント
let blank = Parser.regex re"[ \t]*(#[^\n]*)?\n"

-- [shop]
let header = Parser.map (part "name")
  (Parser.regex re"\[(?<name>\w+)\][ \t]*\n")

-- name = Lam Shop
let setting = Parser.map (\m -> (part "key" m, part "value" m))
  (Parser.regex re"[ \t]*(?<key>\w+)[ \t]*=[ \t]*(?<value>[^\n]*?)[ \t]*\n")

-- A section: its header, then settings and blank lines.
-- セクション：見出しと、そのあとの設定と空の行
let section = Parser.do
  name <- header
  lines <- Parser.many (Parser.oneOf
    [ Parser.map Just setting
    , Parser.map (\_ -> Nothing) blank ])
  let pairs = foldr
        (\l rest -> case l of | Just kv -> kv : rest | Nothing -> rest)
        [] lines
  Parser.pure (name, Map.fromList pairs)

let ini = Parser.do
  _ <- Parser.many blank
  sections <- Parser.many section
  Parser.pure (Map.fromList sections)

-- The text must end with a new line, so one is added.
-- 文字列は改行で終わらなければならないので、1つ足す
Parser.run ini (settings ++ "\n")
