-- 📊 How many files of each extension, and how big, under a folder.
-- フォルダーの下の、拡張子ごとのファイルの数と大きさ

-- 📏 A file and its size.
-- ファイルとその大きさ
sizeOf : String -> IO (Result String (String, Int))
sizeOf path = do
  info <- File.info path ?
  pure (Ok (path, info.size))

-- 🔤 The extension in small letters ("JPG" and "jpg" are the same).
-- 小文字の拡張子（"JPG" も "jpg" も同じ）
extOf : String -> String
extOf path =
  let e = String.toLower (Path.extension path) in
  if e == ""
    then "(none)"
    else e

-- 🧮 A size for people: 5.0 MB, 300 KB, 28 B.
-- 人が読む大きさ
human : Int -> String
human size =
  case size of
    | s if s >= 1024 * 1024 -> f"{toFloat s / 1048576.0:.1} MB"
    | s if s >= 1024 -> f"{s // 1024} KB"
    | s -> f"{s} B"

--- Count the files under a folder by extension
-- フォルダーの下のファイルを、拡張子ごとに数える
main : { dir : String } -> IO (Result String ())
main o = do
  paths <- File.glob f"{o.dir}/**/*" ?
  -- Only the files, not the folders. / フォルダーを除き、ファイルだけ
  isFile <- mapM File.isFile paths
  let onlyFiles = zip paths isFile |> filter snd |> map fst
  found <- mapM sizeOf onlyFiles
  files <- pure (Result.combine found) ?
  let both (n1, s1) (n2, s2) = (n1 + n2, s1 + s2)
  let byExt = foldl (\m (p, s) -> Map.insertWith both (extOf p) (1, s) m)
                    Map.empty files
  Map.toList byExt
    |> sortOn (\(_, (_, s)) -> -s)
    |> map (\(e, (n, s)) -> f"{e:<8}{n:>3} files {human s:>9}")
    |> String.join "\n"
    |> putStrLn
  pure (Ok ())
