-- 🧾 Sum the amounts of a household account book (CSV), by category.
-- 家計簿（CSV）の金額を、カテゴリーごとに合計する

-- 📄 One row: only the columns we use.
-- 1行：使う列だけ
type alias Expense = { category : String, amount : Int }

-- 🔍 Read a row (Csv.int reads the column amount as a number).
-- 1行を読む（Csv.int で amount の列を数として読む）
expense : Decoder Expense
expense =
  Decode.map2 (\c a -> { category = c, amount = a })
    (Decode.field "category" Decode.string)
    (Decode.field "amount" Decode.int)

--- Sum a household account book by category
-- 家計簿をカテゴリーごとに合計する
main : { file : String } -> IO (Result String ())
main o = do
  text <- readFile o.file ?
  rows <- pure (Result.mapError Decode.explain
                  (Csv.decode {"amount": Csv.int} expense text)) ?
  let sums = foldl (\m e -> Map.insertWith (+) e.category e.amount m)
                   Map.empty rows
  forEach (sortOn (\(_, n) -> -n) (Map.toList sums)) (\(c, n) ->
    putStrLn f"{c:<8}{n:>8,}")
  putStrLn f"{"total":<8}{sum (Map.values sums):>8,}"
  pure (Ok ())
