-- 📡 Serve the files of a folder, like python3 -m http.server.
--    "/" is index.html; a path with ".." is not served.
-- フォルダーのファイルを配る（python3 -m http.server のように）。
-- 「/」は index.html。「..」のある道は配らない

-- 📄 The file for a path, if it may be served.
-- 道に当たるファイル（配ってよければ）
fileFor : String -> String -> Maybe String
fileFor dir path =
  case Http.segments path of
    | parts if elem ".." parts -> Nothing
    | [] -> Just (Path.join dir "index.html")
    | parts -> Just (foldl Path.join dir parts)

--- Serve the files of a folder
-- フォルダーのファイルを配る
main : { port : Int = 8000, dir : String = "." } -> IO ()
main o = Http.serve o.port (\req ->
  case fileFor o.dir req.path of
    | Nothing -> pure (Response.text 403 "no")
    | Just file -> Response.file file)
