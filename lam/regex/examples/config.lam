-- Step 1 of the training: read the lines of a settings file into a
-- map, with named groups. Comments (#) and empty lines are skipped.
-- トレーニングのステップ1：設定ファイルの行を、名前付きのグループで
-- 読んで Map にする。コメント（#）と空の行は飛ばす

let settings =
  [ "# the settings of the shop"
  , "name = Lam Shop"
  , "  open=9"
  , ""
  , "close   =  18  " ]

-- key = value, with any spaces around the = and at both ends.
-- 「キー = 値」。= のまわりと両端の空白は、いくつでもよい
let setting = re"^\s*(?<key>\w+)\s*=\s*(?<value>.*?)\s*$"

let add counts line =
  case Regex.find setting line of
    | Nothing -> counts
    | Just m ->
        case (Match.named "key" m, Match.named "value" m) of
          | (Just k, Just v) -> Map.insert k v counts
          | _ -> counts

foldl add {} settings
