-- Step 2 of the training: write the dates the other way round,
-- 2026-11-16 as 16/11/2026, with a function and an f-string.
-- トレーニングのステップ2：日付を逆の順に書きかえる。
-- 2026-11-16 を 16/11/2026 に。関数と f-string で

let date = re"(?<y>\d{4})-(?<m>\d\d)-(?<d>\d\d)"

let part name m = fromMaybe "" (Match.named name m)

let dmy text =
  Regex.replaceWith date
    (\m -> f"{part "d" m}/{part "m" m}/{part "y" m}")
    text

dmy "shipped 2026-11-16, paid 2026-11-20, not a date: 2026-1-2"
