-- Step 3 of the training: Regex.escape, written in Lam. Every letter
-- that means something in a regex gets a \ in front, so the regex
-- finds the text as it is.
-- トレーニングのステップ3：Regex.escape を Lam で書く。正規表現で
-- 意味を持つ文字の前に \ を付けて、文字そのものを探す正規表現にする

let special = chars "\\^$.|?*+()[]{}"

let elem x xs = not (null (filter (\y -> y == x) xs))

let escapeChar c = if elem c special then "\\" ++ c else c

let Regex.escape text = join "" (map escapeChar (chars text))

-- How many times does the text appear, as it is?
-- 文字そのものが、何回出てくるか
let countText word text =
  case Regex.compile (Regex.escape word) of
    | Ok r -> length (Regex.findAll r text)
    | Err _ -> 0

(Regex.escape "1+1=2?", countText "1+1" "1+1=2, 1+1+1=3, 11=11")
