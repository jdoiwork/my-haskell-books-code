cabal-version: 3.0
name:          minisearch
version:       0.2.0.0
build-type:    Simple

-- 第6部 ミニ全文検索エンジン（2. インデクサーを CLI ツールにする）

common shared
  default-language: GHC2024
  ghc-options:      -Wall
  build-depends:
    , base             >=4.20 && <5
    , containers       ^>=0.8
    , text             ^>=2.1

library
  import:           shared
  exposed-modules:  MiniSearch.Types
                    MiniSearch.Tokenize
                    MiniSearch.Index
                    MiniSearch.Search
                    MiniSearch.Samples
                    MiniSearch.Load
                    MiniSearch.Store
                    MiniSearch.Snippet
                    MiniSearch.Report
                    MiniSearch.Cli
                    MiniSearch.Answers
  hs-source-dirs:   src answers
  build-depends:
    , aeson                ^>=2.3
    , bytestring           ^>=0.12
    , directory            ^>=1.3
    , filepath             ^>=1.5
    , optparse-applicative ^>=0.19

-- ANCHOR: exe
executable minisearch
  import:           shared
  main-is:          Main.hs
  hs-source-dirs:   app
  build-depends:
    , minisearch
    , optparse-applicative ^>=0.19
-- ANCHOR_END: exe

test-suite minisearch-test
  import:           shared
  type:             exitcode-stdio-1.0
  main-is:          Spec.hs
  hs-source-dirs:   test
  build-depends:
    , minisearch
    , aeson                ^>=2.3
    , hspec                ^>=2.11
    , optparse-applicative ^>=0.19
    , QuickCheck           ^>=2.19
