cabal-version: 3.0
name:          minisearch
version:       0.3.0.0
build-type:    Simple

-- 第7部 ミニ全文検索エンジン（3. 検索 Web API を公開する）

common shared
  default-language: GHC2024
  ghc-options:      -Wall
  build-depends:
    , base             >=4.20 && <5
    , containers       ^>=0.8
    , text             ^>=2.1

library
  import:           shared
  exposed-modules:  MiniSearch.Types
                    MiniSearch.Tokenize
                    MiniSearch.Index
                    MiniSearch.Search
                    MiniSearch.Samples
                    MiniSearch.Load
                    MiniSearch.Store
                    MiniSearch.Snippet
                    MiniSearch.Report
                    MiniSearch.Cli
                    MiniSearch.Query
                    MiniSearch.Api
                    MiniSearch.Answers
  hs-source-dirs:   src answers
  build-depends:
    , aeson                ^>=2.3
    , bytestring           ^>=0.12
    , directory            ^>=1.3
    , filepath             ^>=1.5
    , optparse-applicative ^>=0.19
    , servant-server       ^>=0.20.3

-- ANCHOR: exe
executable minisearch
  import:           shared
  main-is:          Main.hs
  hs-source-dirs:   app
  build-depends:
    , minisearch
    , optparse-applicative ^>=0.19
-- ANCHOR_END: exe

-- ANCHOR: server
executable minisearch-server
  import:           shared
  main-is:          Server.hs
  hs-source-dirs:   app
  ghc-options:      -threaded
  build-depends:
    , minisearch
    , warp                 ^>=3.4
-- ANCHOR_END: server

test-suite minisearch-test
  import:           shared
  type:             exitcode-stdio-1.0
  main-is:          Spec.hs
  hs-source-dirs:   test
  build-depends:
    , minisearch
    , aeson                ^>=2.3
    , bytestring           ^>=0.12
    , hspec                ^>=2.11
    , hspec-wai            ^>=0.12
    , hspec-wai-json       ^>=0.12
    , optparse-applicative ^>=0.19
    , QuickCheck           >=2.18 && <2.20
