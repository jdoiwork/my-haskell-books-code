cabal-version: 3.0
name:          review-toolbox
version:       0.1.0.0
build-type:    Simple

-- 「第2部のふりかえり」の総合トレーニングのコード

common shared
  default-language: GHC2024
  ghc-options:      -Wall
  build-depends:
    , base                 >=4.20 && <5
    , aeson                ^>=2.3
    , bytestring           ^>=0.12
    , optparse-applicative ^>=0.19
    , text                 ^>=2.1

-- The pure parts: gold, the loot book, and the command line.
-- 純粋な部分：ゴールド、戦利品の目録、コマンドライン
library
  import:           shared
  exposed-modules:  Loot.Gold
                    Loot.Book
                    Loot.Cli
  hs-source-dirs:   src

-- The lootbook command: total and top.
-- lootbook コマンド：total と top
executable lootbook
  import:           shared
  main-is:          Main.hs
  hs-source-dirs:   app
  build-depends:    review-toolbox

test-suite review-toolbox-test
  import:           shared
  type:             exitcode-stdio-1.0
  main-is:          Spec.hs
  hs-source-dirs:   test
  build-depends:
    , review-toolbox
    , hspec      ^>=2.11
    , QuickCheck ^>=2.19
