cabal-version: 3.0
name:          deepmonad
version:       0.1.0.0
build-type:    Simple

-- 「Functor・Applicative・Monad をもっと深く」の章のコード

common shared
  default-language: GHC2024
  ghc-options:      -Wall
  build-depends:    base >=4.20 && <5

library
  import:           shared
  exposed-modules:  Recap
                    Useful
                    Quest
                    Counted
                    Steps
                    Validation
                    Instances
                    DeepAnswers
  hs-source-dirs:   src answers

test-suite deepmonad-test
  import:           shared
  type:             exitcode-stdio-1.0
  main-is:          Spec.hs
  hs-source-dirs:   test
  build-depends:
    , deepmonad
    , hspec            ^>=2.11
    , QuickCheck       ^>=2.19
