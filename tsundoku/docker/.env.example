# Copy this to .env and change what you like.
# .env に写して、好きなところを変える

# sqlite, or postgres (and make db_password.txt)
# sqlite か postgres（postgres なら db_password.txt も作る）
COMPOSE_PROFILES=sqlite

# the image, from a registry or built here
# イメージ（置き場のものか、ここでビルドしたもの）
TSUNDOKU_IMAGE=tsundoku:0.1

# the port on this machine, and how ratings look (hundred, stars, ten, ten.1)
# このマシンのポートと、評価の見せ方（hundred・stars・ten・ten.1）
TSUNDOKU_PORT=8080
TSUNDOKU_RATING=stars
