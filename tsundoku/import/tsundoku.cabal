cabal-version: 3.0
name:          tsundoku
version:       0.1.0.0
build-type:    Simple

-- 総合演習：読書メモのレビューサイトを作る
-- （6. 本を取り込む：EPUB・PDF・ISBN から目次を作る）

common shared
  default-language: GHC2024
  default-extensions: OverloadedStrings
  ghc-options:      -Wall
  build-depends:
    , base             >=4.20 && <5
    , containers       ^>=0.8
    , text             ^>=2.1
    , time             >=1.12 && <1.16

-- ANCHOR: library
library
  import:           shared
  exposed-modules:  Tsundoku.Types
                    Tsundoku.Rating
                    Tsundoku.Reading
                    Tsundoku.Card
                    Tsundoku.Progress
                    Tsundoku.Bar
                    Tsundoku.Ranking
                    Tsundoku.Chart
                    Tsundoku.Examples
                    Tsundoku.Outline
                    Tsundoku.Shelf
                    Tsundoku.Shelf.Rows
                    Tsundoku.Shelf.Memory
                    Tsundoku.Shelf.Sqlite
                    Tsundoku.Shelf.Postgres
                    Tsundoku.Shelf.Config
                    Tsundoku.Validation
                    Tsundoku.Custom
                    Tsundoku.Field
                    Tsundoku.Query
                    Tsundoku.Form
                    Tsundoku.Isbn
                    Tsundoku.Import.Types
                    Tsundoku.Import.Epub
                    Tsundoku.Import.Sample
                    Tsundoku.Import.Pdf
                    Tsundoku.Import.Http
                    Tsundoku.Import.OpenBd
                    Tsundoku.Import.Narou
                    Tsundoku.Import
                    ShelfAnswers.Podcast
                    ShelfAnswers.Grades
                    ShelfAnswers.LookBack
                    ShelfAnswers.HalfRead
                    ShelfAnswers.FirstUnread
                    ShelfAnswers.ColorBar
                    ShelfAnswers.Weights
                    ShelfAnswers.Recent
                    ShelfAnswers.ByKind
                    ShelfAnswers.Orphans
                    ShelfAnswers.Tags
                    ShelfAnswers.Move
                    ShelfAnswers.Url
                    ShelfAnswers.Redefine
                    ShelfAnswers.OrNot
                    ShelfAnswers.Ruby
                    ShelfAnswers.Depth
                    ShelfAnswers.Isbn13
  hs-source-dirs:   src answers
  -- ANCHOR: deps
  -- unicode-show: to show Japanese as it is in GHCi (uprint)
  -- unicode-show：GHCi で日本語をそのまま見せるため（uprint）
  build-depends:
    , aeson              ^>=2.3
    , bytestring         ^>=0.12
    , directory          ^>=1.3
    , filepath           ^>=1.5
    , hasql              ^>=2.0
    , http-client        ^>=0.7.19
    , http-types         ^>=0.12.4
    , hasql-transaction  ^>=1.2.3
    , megaparsec         ^>=9.8
    , mtl                ^>=2.3
    , parser-combinators ^>=1.3
    , pqi-ffi            ^>=1.0
    , scientific         ^>=0.3.8
    , sqlite-simple      ^>=0.4.19
    , tagsoup            ^>=0.14.8
    , transformers       ^>=0.6
    , typed-process      ^>=0.2.13
    , unicode-show       ^>=0.1.1
    , xml-conduit        ^>=1.10
    , zip-archive        ^>=0.5
    , zlib               ^>=0.7.1
  -- ANCHOR_END: deps
-- ANCHOR_END: library

-- ANCHOR: exe
-- The shelf from the command line, on the store TSUNDOKU_DB chooses.
-- コマンドから使う本棚。しまう場所は TSUNDOKU_DB で選ぶ
executable shelf
  import:           shared
  main-is:          Main.hs
  hs-source-dirs:   app
  build-depends:
    , tsundoku
    , bytestring       ^>=0.12
    , filepath         ^>=1.5
    , http-client-tls  ^>=0.3.6
-- ANCHOR_END: exe

-- ANCHOR: test
test-suite tsundoku-test
  import:           shared
  type:             exitcode-stdio-1.0
  main-is:          Spec.hs
  hs-source-dirs:   test
  other-modules:    ShelfContract
                    ShelfSpec
                    CustomSpec
                    ImportSpec
  -- The overlap test waits in libpq (C) on one thread while another
  -- thread goes on: that needs the threaded runtime.
  -- 重なりのテストは、1つのスレッドが libpq（C）の中で待つあいだに、
  -- ほかのスレッドが進む。それには threaded のランタイムが要る
  ghc-options:      -threaded
  build-depends:
    , tsundoku
    , bytestring       ^>=0.12
    , directory        ^>=1.3
    , filepath         ^>=1.5
    , http-client      ^>=0.7.19
    , hasql            ^>=2.0
    , hspec            ^>=2.11
    , pqi-ffi          ^>=1.0
    , process          ^>=1.6
    , QuickCheck       ^>=2.19
    , sqlite-simple    ^>=0.4.19
    , testcontainers   ^>=0.5.4
-- ANCHOR_END: test
