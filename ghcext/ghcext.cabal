cabal-version: 3.0
name:          ghcext
version:       0.1.0.0
build-type:    Simple

-- 「GHC 拡張」の章のコード

common shared
  default-language: GHC2024
  ghc-options:      -Wall
  build-depends:
    , base             >=4.20 && <5
    , text             ^>=2.1
    , aeson            ^>=2.3

library
  import:           shared
  exposed-modules:  Shop
                    Money
                    Records
                    Labels
                    Ado
                    Strings
                    ExtAnswers
  hs-source-dirs:   src answers

test-suite ghcext-test
  import:           shared
  type:             exitcode-stdio-1.0
  main-is:          Spec.hs
  hs-source-dirs:   test
  build-depends:
    , ghcext
    , hspec            ^>=2.11
