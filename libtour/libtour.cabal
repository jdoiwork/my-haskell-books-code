cabal-version: 3.16
name:          libtour
version:       0.1.0.0
build-type:    Simple

-- 「よく使うライブラリ」の章のコード

common shared
  default-language: GHC2024
  ghc-options:      -Wall
  build-depends:
    , array      ^>=0.5
    , base       ^>=4.22.0.0
    , bytestring ^>=0.12
    , containers ^>=0.8
    , text       ^>=2.1
    , time       ^>=1.15
    , vector     ^>=0.13

library
  import:           shared
  exposed-modules:
    Bytes
    Deadline
    LibAnswers
    Queue
    Shelf
  hs-source-dirs:   src answers
