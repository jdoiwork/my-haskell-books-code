cabal-version: 3.16
name:          mondex
version:       0.1.0.0
build-type:    Simple

-- 「CLI ツールを作る」の章のコード

common shared
  default-language: GHC2024
  ghc-options:      -Wall
  build-depends:    base ^>=4.22.0.0

-- The pure parts: the monsters, the command line, and the core.
-- 純粋な部分：モンスター、コマンドライン、核
library
  import:           shared
  exposed-modules:
    Mondex.Command
    Mondex.Core
    Mondex.DoStyle
    Mondex.Monlist
    Mondex.Monster
    Mondex.Store
    -- answers for the training / トレーニングの解答
    DiceAnswers
  hs-source-dirs:   src answers
  build-depends:
    , aeson                ^>=2.3
    , aeson-pretty         ^>=0.8
    , bytestring           ^>=0.12
    , directory            ^>=1.3
    , optparse-applicative ^>=0.19
    , text                 ^>=2.1

-- The first command: monlist (options only, no subcommands).
-- 最初のコマンド：monlist（オプションだけ。サブコマンドなし）
executable monlist
  import:           shared
  main-is:          MonList.hs
  hs-source-dirs:   app
  build-depends:
    , mondex
    , optparse-applicative ^>=0.19
    , text                 ^>=2.1

-- The second command: mondex (with subcommands).
-- 2つ目のコマンド：mondex（サブコマンドあり）
executable mondex
  import:           shared
  main-is:          Main.hs
  hs-source-dirs:   app
  build-depends:
    , mondex
    , optparse-applicative ^>=0.19
    , text                 ^>=2.1

-- The tests: the command line and the pure core.
-- テスト：コマンドラインと、純粋な核
test-suite mondex-test
  import:           shared
  type:             exitcode-stdio-1.0
  main-is:          Spec.hs
  hs-source-dirs:   test answers-test
  other-modules:
    DiceAnswersSpec
  build-depends:
    , mondex
    , hspec                ^>=2.11
    , hspec-golden         ^>=0.2.2
    , optparse-applicative ^>=0.19
    , text                 ^>=2.1
