cabal-version: 3.0
name:          minimq
version:       0.1.0.0
build-type:    Simple

-- 総合演習：RabbitMQ 風のメッセージブローカーを作る
-- （1. 設計：メッセージ・キュー・配り方を型で描く）

common shared
  default-language: GHC2024
  default-extensions: OverloadedStrings
  ghc-options:      -Wall
  build-depends:
    , base             >=4.20 && <5
    , containers       ^>=0.8
    , text             ^>=2.1
    , transformers     ^>=0.6

library
  import:           shared
  exposed-modules:  MiniMq.Types
                    MiniMq.Broker
                    MiniMq.Examples
                    MqAnswers
  hs-source-dirs:   src answers

test-suite minimq-test
  import:           shared
  type:             exitcode-stdio-1.0
  main-is:          Spec.hs
  hs-source-dirs:   test
  build-depends:
    , minimq
    , hspec            ^>=2.11
    , QuickCheck       ^>=2.19
