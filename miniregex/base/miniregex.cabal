cabal-version: 3.0
name:          miniregex
version:       0.1.0.0
build-type:    Simple

-- 総合演習：PCRE2 互換の正規表現エンジンを作る
-- （17. Haskell の仲間に入る：regex-base と =~）

common shared
  default-language: GHC2024
  default-extensions: OverloadedStrings
  ghc-options:      -Wall
  build-depends:
    , base             >=4.20 && <5
    , text             ^>=2.1

library
  import:           shared
  exposed-modules:  MiniRegex
                    MiniRegex.Types
                    MiniRegex.Syntax
                    MiniRegex.Parser
                    MiniRegex.Pretty
                    MiniRegex.Groups
                    MiniRegex.Width
                    MiniRegex.Cursor
                    MiniRegex.Caps
                    MiniRegex.Unicode
                    MiniRegex.Rules
                    MiniRegex.Candidates
                    MiniRegex.Continuation
                    MiniRegex.Program
                    MiniRegex.Compile
                    MiniRegex.VM
                    MiniRegex.Stack
                    MiniRegex.STVM
                    MiniRegex.Pike
                    MiniRegex.PikeST
                    MiniRegex.Bounded
                    MiniRegex.Race
                    MiniRegex.Prefilter
                    MiniRegex.LazyDFA
                    MiniRegex.Engine
                    MiniRegex.Template
                    MiniRegex.Examples
                    MiniRegex.Compat
                    MiniRegex.Portable
                    Text.Regex.MiniRegex
                    RegexAnswers
                    RegexBaseAnswers
  hs-source-dirs:   src answers
  -- The parser, and the names of the groups it has read
  -- パーサーと、読んだグループの名前の記録
  build-depends:
    , megaparsec       ^>=9.8
    , containers       ^>=0.8
    , mtl              ^>=2.3
    -- The program of the VM: an array of instructions
    -- VM のプログラム：命令の配列
    , array            ^>=0.5
    -- The VM with ST: mutable arrays
    -- ST の VM：書き換えられる配列
    , vector           ^>=0.13
    -- Racing the two engines
    -- 2つのエンジンの競走
    , async            ^>=2.2
    -- The scripts of Unicode 17, the same version as PCRE2 10.49's
    -- Unicode 17 の文字体系（PCRE2 10.49 と同じ版）
    , unicode-data-scripts ^>=0.6
    -- The type classes that Haskell's regex libraries share
    -- Haskell の正規表現ライブラリが共通に使う型クラス
    , regex-base       ^>=0.94
    -- To compare with regex-tdfa in GHCi
    -- GHCi で regex-tdfa とくらべるため
    , regex-tdfa       ^>=1.3
    -- The training: finding in a ByteString
    -- トレーニング：ByteString の中を探す
    , bytestring       ^>=0.12
    -- To see Japanese in GHCi (uprint)
    -- GHCi で日本語を見るため（uprint）
    , unicode-show     ^>=0.1

-- The compatibility meter: how many of PCRE2's tests pass.
-- 互換度メーター：PCRE2 のテストのうち、いくつ通るか
executable compat-meter
  import:           shared
  main-is:          Meter.hs
  hs-source-dirs:   app
  build-depends:
    , miniregex
    , containers       ^>=0.8

-- Time the engines and the race between them, with a clock of our own.
-- エンジンと、そのあいだの競走を、自分で時計を見て測る
executable race-clock
  import:           shared
  main-is:          RaceClock.hs
  hs-source-dirs:   app
  ghc-options:      -O1 -threaded
  build-depends:
    , miniregex

test-suite miniregex-test
  import:           shared
  type:             exitcode-stdio-1.0
  main-is:          Spec.hs
  hs-source-dirs:   test neighbor
  -- The jobs from the next town, with regex-tdfa and with MiniRegex
  -- 隣町の仕事。regex-tdfa 版と MiniRegex 版
  other-modules:    Neighbor
                    NeighborMini
  build-depends:
    , miniregex
    , containers       ^>=0.8
    , hspec            ^>=2.11
    , QuickCheck       ^>=2.19
    -- The real PCRE2, to compare with (the C library comes inside)
    -- くらべる相手の本物の PCRE2（C のライブラリが中に入っている）
    , pcre2            ^>=2.3
    -- The same code with regex-tdfa and with MiniRegex
    -- 同じコードを、regex-tdfa でも MiniRegex でも
    , regex-base       ^>=0.94
    , regex-tdfa       ^>=1.3
    , array            ^>=0.5
    , bytestring       ^>=0.12

-- Measure the ways to choose an engine.
-- エンジンの選び方を測りくらべる
benchmark miniregex-bench
  import:           shared
  type:             exitcode-stdio-1.0
  main-is:          Bench.hs
  hs-source-dirs:   bench
  ghc-options:      -O1
  build-depends:
    , miniregex
    , tasty-bench      ^>=0.5
