/colou?r|gr(a|e)y/bincode
------------------------------------------------------------------
        Bra
        colo
        u?+
        r
        Alt
        gr
        CBra 1
        a
        Alt
        e
        Ket
        y
        Ket
        End
------------------------------------------------------------------

/^(\w+\s?)+$/bincode
------------------------------------------------------------------
        Bra
        ^
        CBra 1
        \w+
        \s?
        KetRmax
        $
        Ket
        End
------------------------------------------------------------------

/a*b/bincode
------------------------------------------------------------------
        Bra
        a*+
        b
        Ket
        End
