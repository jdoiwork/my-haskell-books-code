cabal-version: 3.0
name:          review9
version:       0.1.0.0
build-type:    Simple

-- 「第IX部のふりかえり」の総合トレーニング：ギルドの門番（レート制限）

common shared
  default-language: GHC2024
  default-extensions: OverloadedStrings
  ghc-options:      -Wall
  build-depends:
    , base             >=4.20 && <5
    , minikv
    , text             ^>=2.1

library
  import:           shared
  exposed-modules:  Review.Gate
  hs-source-dirs:   src

test-suite review9-test
  import:           shared
  type:             exitcode-stdio-1.0
  main-is:          Spec.hs
  other-modules:    GateProps
  hs-source-dirs:   test
  ghc-options:      -threaded
  build-depends:
    , review9
    , hspec            ^>=2.11
    , QuickCheck       ^>=2.19
