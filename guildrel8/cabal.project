-- 「hasql と rel8」の章のコード（別のプロジェクト）
-- rel8 1.8.0.0 は、土台の opaleye が GHC 9.14（base 4.22）に未対応で、
-- 自分は GHC 9.10 以降の Prelude（foldl'）を使うので、
-- この章だけ GHC 9.10.3 を使う（2026-11-04 に確認）
packages: .

with-compiler: ghc-9.10.3

-- Find libpq with pkg-config (PKG_CONFIG_PATH on macOS).
-- libpq を pkg-config で探す（macOS では PKG_CONFIG_PATH を設定）
package postgresql-libpq
  flags: +use-pkg-config
