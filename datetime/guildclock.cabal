cabal-version: 3.16
name:          guildclock
version:       0.1.0.0
build-type:    Simple

-- 「日付と時刻」の章のコード（ギルドの依頼の掲示板の暦）

common shared
  default-language: GHC2024
  ghc-options:      -Wall
  build-depends:
    , base         ^>=4.22.0.0
    , time         ^>=1.15
    , unicode-show ^>=0.1

-- The types of time, the calendar, the lengths of time, and the formats.
-- 時間の型、暦の計算、時間の長さ、書式
library
  import:           shared
  exposed-modules:
    Calendar
    DateAnswers
    Formats
    Spans
    TimeMap
  hs-source-dirs:   src answers

-- Tests for the calendar, the lengths, and the formats.
-- 暦・長さ・書式のテスト
test-suite guildclock-test
  import:           shared
  type:             exitcode-stdio-1.0
  main-is:          Spec.hs
  hs-source-dirs:   test
  build-depends:
    , guildclock
    , hspec      ^>=2.11
    , QuickCheck ^>=2.19
