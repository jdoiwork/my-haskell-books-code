cabal-version: 3.16
name:          guildclock
version:       0.1.0.0
build-type:    Simple

-- 「日付と時刻とタイムゾーン」の章のコード（ギルドの依頼の掲示板の時計）

common shared
  default-language: GHC2024
  ghc-options:      -Wall
  build-depends:
    , base         ^>=4.22.0.0
    , time         ^>=1.15
    , tz           ^>=0.1.3
    , unicode-show ^>=0.1

-- The types of time, the board, the branches, the calendar, the formats,
-- and the clock.
-- 時間の型、掲示板、支部、暦の計算、書式、時計
library
  import:           shared
  exposed-modules:
    Board
    Branches
    Calendar
    Clock
    DateAnswers
    Formats
    TimeMap
    Wire
  hs-source-dirs:   src answers

-- Show a quest on the board, in every branch's wall clock.
-- 依頼を、どの支部の壁の時計でも見せる
executable guild-board
  import:           shared
  main-is:          Main.hs
  hs-source-dirs:   app
  build-depends:    guildclock

-- Tests with a stopped clock.
-- 止まった時計でテストする
test-suite guildclock-test
  import:           shared
  type:             exitcode-stdio-1.0
  main-is:          Spec.hs
  hs-source-dirs:   test
  build-depends:
    , guildclock
    , hspec      ^>=2.11
    , QuickCheck ^>=2.19
